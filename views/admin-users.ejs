<div class="admin-users-wrapper">

    <div class="page-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:24px;">
        <div>
            <h1 style="font-size:24px; font-weight:700; margin:0 0 6px 0;">👥 Admin Management</h1>
            <p class="page-subtitle" style="margin:0;">Manage administrator accounts, permissions and login access.</p>
        </div>
        <a href="/admin/admin-users/new" class="button primary">➕ Create Admin</a>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-title">Total Admins</div>
            <div class="stat-value"><%= admins.length %></div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Active</div>
            <div class="stat-value"><%= admins.filter(a => a.is_active).length %></div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Disabled</div>
            <div class="stat-value"><%= admins.filter(a => !a.is_active).length %></div>
        </div>
        <div class="stat-card">
            <div class="stat-title">Google Linked</div>
            <div class="stat-value"><%= admins.filter(a => a.google_sub).length %></div>
        </div>
    </div>

    <div class="table-card">
        <div class="table-header">
            <div>
                <h2 style="margin:0; font-size:18px; font-weight:700;">Administrator Accounts</h2>
                <p style="margin:4px 0 0 0; color:var(--muted); font-size:13px;"><%= admins.length %> account(s) registered</p>
            </div>
            <input
                type="text"
                class="search-box filter-input"
                id="adminUserSearchInput"
                placeholder="Search admin name, title or username..."
                onkeyup="filterAdminUsersTable()"
            >
        </div>

        <div class="table-responsive-wrapper" style="overflow-x:auto; -webkit-overflow-scrolling:touch;">
            <table class="admin-table" id="adminUsersTable">
                <thead>
                    <tr>
                        <th>Name &amp; Title</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Google</th>
                        <th>Status</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% admins.forEach(admin => { %>
                    <tr>
                        <td>
                            <div class="admin-user" style="display:flex; align-items:center; gap:10px;">
                                <div class="admin-avatar">
                                    <%= admin.display_name ? admin.display_name.charAt(0).toUpperCase() : "A" %>
                                </div>
                                <div>
                                    <div class="admin-name" style="font-weight:600;">
                                        <%= admin.display_name %>
                                        <% if (admin.title) { %>
                                            <span class="badge badge-title" style="font-size:10px; padding:2px 8px; margin-left:4px; font-weight:700;"><%= admin.title %></span>
                                        <% } %>
                                    </div>
                                    <div class="admin-id" style="font-size:12px; color:var(--muted);">
                                        ID #<%= admin.id %> <%= admin.title ? '• ' + admin.title : '' %>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <code><%= admin.username %></code>
                        </td>
                        <td>
                            <% if (admin.role === "SUPER_ADMIN" || admin.role === "super_admin" || admin.role === "superadmin") { %>
                                <span class="badge badge-purple">Super Admin</span>
                            <% } else { %>
                                <span class="badge badge-blue">Admin</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (admin.google_sub) { %>
                                <span class="badge badge-green">Linked</span>
                            <% } else { %>
                                <span class="badge badge-gray">Not Linked</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (admin.is_active) { %>
                                <span class="badge badge-green">Active</span>
                            <% } else { %>
                                <span class="badge badge-red">Disabled</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/admin/admin-users/<%= admin.id %>/edit" class="table-btn">✏ Edit</a>
                                <a href="/admin/admin-users/<%= admin.id %>/reset-password" class="table-btn">🔑 Reset</a>
                                <form method="POST" action="/admin/admin-users/<%= admin.id %>/toggle-active">
                                    <button type="submit" class="table-btn"><%= admin.is_active ? "Disable" : "Enable" %></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
function filterAdminUsersTable() {
  const q = (document.getElementById('adminUserSearchInput')?.value || '').toLowerCase();
  const rows = document.querySelectorAll('#adminUsersTable tbody tr');
  rows.forEach(r => {
    const text = r.innerText.toLowerCase();
    r.style.display = text.includes(q) ? '' : 'none';
  });
}
</script>

<div class="container container-lg">
    <div class="header">
      <h1>👤 Singer Directory</h1>
      <p>Devotee Participation Stats</p>
    </div>
    
    <div style="margin-bottom: 20px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <a href="/admin" class="button secondary">⬅️ Back to Admin</a>
      <a href="/admin/singer-dictionary" class="button button-info">📖 Singer Dictionary (Add / Edit / Delete)</a>
    </div>

    <div class="table-container">
      <table id="singerTable">
        <thead>
          <tr>
            <th onclick="sortTable(0, 'singerTable')" style="cursor:pointer;">Singer Name ↕</th>
            <th onclick="sortTable(1, 'singerTable')" style="cursor:pointer; text-align:center;">Total Bhajans Sung ↕</th>
            <th onclick="sortTable(2, 'singerTable')" style="cursor:pointer;">Last Sung Date ↕</th>
          </tr>
        </thead>
        <tbody>
          <% singers.forEach(s => { %>
            <tr>
              <td><strong><%= s.singer_name %></strong></td>
              <td style="text-align:center;"><span class="badge-count"><%= s.total_sung %></span></td>
              <td data-sort="<%= s.last_sung %>"><%= s.formattedDate %> <br><small style="color:var(--muted); font-size:11.5px;"><%= s.lastSungHuman %></small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

          <div class="font-size-adjuster" role="group" aria-label="Adjust font size">
            <button type="button" id="fontDec" class="font-btn" onclick="changeLyricsFontSize(-2)" title="Decrease lyrics font size" aria-label="Decrease font size">A−</button>
            <span id="fontSizeDisplay" class="font-size-indicator" title="Current text size">20px</span>
            <button type="button" id="fontInc" class="font-btn" onclick="changeLyricsFontSize(2)" title="Increase lyrics font size" aria-label="Increase font size">A+</button>
            <button type="button" id="fontReset" class="font-btn font-reset-btn" onclick="changeLyricsFontSize(0)" title="Reset font size to default (20px)" aria-label="Reset font size">↺</button>
          </div>

          <!-- Floral Frame Toggle -->
          <button type="button" id="toggleFrameBtn" class="tool-btn active" onclick="toggleFloralFrame()" title="Toggle sacred floral frame (Double gold border & botanical corners)">
            <span id="frameIcon">🌸</span> <span id="frameText">Frame</span>
          </button>

          <!-- Alignment Toggle -->
          <button type="button" id="toggleAlignBtn" class="tool-btn" onclick="toggleLyricsAlignment()" title="Toggle text alignment (Center / Left)">
            <span id="alignIcon">≡</span> <span id="alignText">Left</span>

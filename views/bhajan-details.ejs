<%
  function getWesternScale(indianScale) {
    if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
    const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
    if (!match) return '-';
    const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
    if (numMap[match[1]] === undefined) return '-';
    let index = numMap[match[1]];
    if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12;
    return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
  }

  const hasLyrics = bhajan.lyrics && bhajan.lyrics.trim().length > 0;
  const westM = getWesternScale(bhajan.shruti);
  const westF = getWesternScale(bhajan.shruti_female);

  // Split lyrics into paragraphs/stanzas
  const stanzas = hasLyrics 
    ? bhajan.lyrics.trim().split(/\r?\n\s*\r?\n/).filter(Boolean)
    : [];

  // Calculate total non-empty lyrics lines for dynamic full-frame print layout
  const totalLyricsLines = stanzas.reduce((acc, st) => {
    return acc + st.split(/\r?\n/).filter(l => l.trim().length > 0).length;
  }, 0);

  let printDensityClass = 'print-spacious';
  if (totalLyricsLines > 22) {
    printDensityClass = 'print-compact';
  } else if (totalLyricsLines > 13) {
    printDensityClass = 'print-medium';
  }
%>

<div class="bhajan-detail-page <%= printDensityClass %>">
  <div class="container detail-container">

    <!-- Top Breadcrumb & Navigation -->
    <nav class="detail-nav-bar" aria-label="Breadcrumb navigation">
      <a href="/master-bank" class="detail-back-btn" id="backToBankBtn">
        <span class="back-arrow">←</span> Master Bhajan Bank
      </a>
      <div class="detail-breadcrumbs">
        <a href="/master-bank">Master Bank</a>
        <span class="crumb-sep">/</span>
        <% if (bhajan.deity) { %>
          <span class="crumb-deity"><%= bhajan.deity %></span>
          <span class="crumb-sep">/</span>
        <% } %>
        <span class="crumb-current" title="<%= bhajan.title %>"><%= bhajan.title %></span>
      </div>
    </nav>

    <!-- Sacred Header Card -->
    <header class="detail-hero-card">
      <div class="detail-hero-content">
        <h1 class="detail-bhajan-title" id="bhajanTitleDisplay"><%= bhajan.title %></h1>
        <div class="detail-badge-strip">
          <% if (bhajan.deity) { %>
            <% bhajan.deity.split(',').map(d => d.trim()).filter(Boolean).forEach(d => { %>
              <span class="hero-pill deity-pill">🕉️ <%= d %></span>
            <% }); %>
          <% } %>
          <% if (bhajan.tempo) { %>
            <span class="hero-pill tempo-pill">⏱️ <%= bhajan.tempo %></span>
          <% } %>
          <% if (bhajan.raga && bhajan.raga !== '-' && bhajan.raga !== 'Not specified') { %>
            <span class="hero-pill raga-pill">🎼 Raag <%= bhajan.raga %></span>
          <% } %>
          <% if (bhajan.language) { %>
            <span class="hero-pill lang-pill">🗣️ <%= bhajan.language %></span>
          <% } %>
          <% if (bhajan.sheet_filename) { %>
            <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="hero-pill sheet-pill" title="Open official PDF music notation & sheet">
              📄 Music Sheet ↗
            </a>
          <% } %>
        </div>
      </div>
    </header>

    <!-- ======================================================== -->
    <!-- 1. TOP SECTION: SACRED BHAJAN LYRICS (FIRST AT TOP)       -->
    <!-- ======================================================== -->
    <section class="lyrics-section-card" id="lyricsSection" aria-label="Bhajan Lyrics">
      
      <!-- Lyrics Action Toolbar: Font Resize + Copy + Print + Music Sheet -->
      <div class="lyrics-toolbar">
        <div class="lyrics-controls-group">
          <!-- Tactile Font Size Adjustment (+ / - / Reset) -->
          <div class="font-size-adjuster" role="group" aria-label="Adjust font size">
            <button type="button" id="fontDec" class="font-btn" onclick="changeLyricsFontSize(-2)" title="Decrease lyrics font size" aria-label="Decrease font size">A−</button>
            <span id="fontSizeDisplay" class="font-size-indicator" title="Current text size">20px</span>
            <button type="button" id="fontInc" class="font-btn" onclick="changeLyricsFontSize(2)" title="Increase lyrics font size" aria-label="Increase font size">A+</button>
            <button type="button" id="fontReset" class="font-btn font-reset-btn" onclick="changeLyricsFontSize(0)" title="Reset font size to default (20px)" aria-label="Reset font size">↺</button>
          </div>

          <!-- Floral Frame Toggle -->
          <button type="button" id="toggleFrameBtn" class="tool-btn active" onclick="toggleFloralFrame()" title="Toggle sacred floral frame (Double gold border & botanical corners)">
            <span id="frameIcon">🌸</span> <span id="frameText">Frame</span>
          </button>

          <!-- Alignment Toggle -->
          <button type="button" id="toggleAlignBtn" class="tool-btn" onclick="toggleLyricsAlignment()" title="Toggle text alignment (Center / Left)">
            <span id="alignIcon">≡</span> <span id="alignText">Left</span>
          </button>

          <!-- Copy Lyrics Button -->
          <button type="button" id="copyLyricsBtn" class="tool-btn copy-btn" onclick="copyBhajanLyrics()" title="Copy full lyrics to clipboard">
            <span class="btn-icon" id="copyIcon">📋</span>
            <span id="copyBtnText">Copy</span>
          </button>

          <!-- Print Button -->
          <button type="button" onclick="window.print()" class="tool-btn print-btn no-print" title="Print lyrics sheet">
            <span class="btn-icon">🖨️</span>
            <span class="btn-text">Print</span>
          </button>

          <% if (bhajan.sheet_filename) { %>
            <!-- Official Music Sheet Button -->
            <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="tool-btn sheet-btn no-print" title="Open official reference music sheet (PDF)">
              <span class="btn-icon">📄</span>
              <span class="btn-text">Music Sheet</span>
            </a>
          <% } %>

          <!-- Schedule This Bhajan Button (Phase 4) -->
          <a href="/submit-form?prefill_title=<%= encodeURIComponent(bhajan.title) %>&prefill_deity=<%= encodeURIComponent(bhajan.deity || '') %>&prefill_scale=<%= encodeURIComponent(bhajan.shruti || '') %>&prefill_speed=<%= encodeURIComponent(bhajan.tempo || '') %>&master_id=<%= bhajan.id %>" class="tool-btn schedule-tool-btn no-print" title="Schedule this bhajan for the upcoming session" style="color: #16a34a; border-color: rgba(22, 163, 74, 0.4); text-decoration: none; font-weight: 700;">
            <span class="btn-icon">🎤</span>
            <span class="btn-text">Schedule</span>
          </a>

          <!-- Add to My Songbook / Repertoire Button (Phase 2) -->
          <button type="button" id="songbookBtn" onclick="openSongbookModal()" class="tool-btn songbook-btn no-print" title="Save this bhajan to your personal Songbook repertoire" style="color: #7c3aed; border-color: rgba(124, 58, 237, 0.35);">
            <span class="btn-icon" id="songbookIcon">⭐</span>
            <span id="songbookBtnText">Songbook</span>
          </button>

          <!-- Report Issue / Suggest Correction Button -->
          <button type="button" onclick="openReportModal()" class="tool-btn report-btn no-print" title="Report incorrect lyrics, scale, or details" style="color: #b45309; border-color: rgba(217, 119, 6, 0.35);">
            <span class="btn-icon">🚩</span>
            <span class="btn-text">Report Issue</span>
          </button>

          <!-- Track Reports Button -->
          <a href="/my-reports" class="tool-btn track-btn no-print" id="trackReportsLink" title="Track your reported issues & admin replies" style="text-decoration:none; position:relative;">
            <span class="btn-icon">📋</span>
            <span class="btn-text">My Reports</span>
            <span id="unreadReplyDot" style="display:none; position:absolute; top:-4px; right:-4px; width:10px; height:10px; background:#ef4444; border-radius:50%; border:2px solid #fff; box-shadow:0 0 6px #ef4444;"></span>
          </a>
        </div>
      </div>

      <!-- Devotional Lyrics Reading Area (Sacred Golden Floral Frame) -->
      <div class="lyrics-parchment floral-frame-active" id="lyricsViewport">
        <!-- Botanical Corner Embellishments: Top-Left & Bottom-Right -->
        <img src="/images/corner-floral-tl.svg" class="parchment-corner corner-tl" alt="" aria-hidden="true" />
        <img src="/images/corner-floral-br.svg" class="parchment-corner corner-br" alt="" aria-hidden="true" />
        
        <!-- Sacred Central Watermark Glow -->
        <div class="parchment-watermark" aria-hidden="true"></div>

        <% if (hasLyrics) { %>
          <div class="lyrics-container" id="lyricsContainer">
            <% stanzas.forEach((stanza, sIdx) => { %>
              <div class="lyrics-stanza <%= sIdx === 0 ? 'first-stanza' : '' %>" data-stanza-idx="<%= sIdx + 1 %>">
                <% stanza.split(/\r?\n/).forEach(line => { %>
                  <% if (line.trim().length > 0) { %>
                    <div class="lyrics-line"><%= line.trim() %></div>
                  <% } %>
                <% }) %>
              </div>
              <% if (sIdx < stanzas.length - 1) { %>
                <div class="stanza-ornament" aria-hidden="true">✦ ✦ ✦</div>
              <% } %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="lyrics-empty-state">
            <span class="empty-icon">🪔</span>
            <h3>Lyrics Currently Being Transcribed</h3>
            <p>The lyrics for this bhajan are being formatted. Pitch and harmonium references are provided below.</p>
          </div>
        <% } %>
      </div>

      <!-- Hidden Raw Data Elements for Clipboard & Scripts (Safe against quotes/escapes) -->
      <div id="rawBhajanData" 
           data-title="<%= bhajan.title %>" 
           data-deity="<%= bhajan.deity || '' %>" 
           style="display:none;" 
           aria-hidden="true">
        <textarea id="rawLyricsText"><%= bhajan.lyrics || '' %></textarea>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- 2. BOTTOM SECTION: ACCOMPANIMENT & MUSICAL DETAILS       -->
    <!-- ======================================================== -->
    <section class="metadata-section-card" id="accompanimentSection" aria-label="Musical Accompaniment & Specifications">
      <div class="meta-section-header">
        <span class="meta-header-icon">🎼</span>
        <div>
          <h2 class="meta-section-title">Musical Accompaniment & Singing Guide</h2>
          <p class="meta-section-sub">Standard references for harmonium, keyboard, tabla, and vocalists</p>
        </div>
      </div>

      <div class="meta-specs-grid">
        
        <!-- Male Scale / Shruti -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🎹</div>
          <div class="spec-tile-info">
            <span class="spec-label">Male Scale / Shruti</span>
            <span class="spec-value">
              <% if (bhajan.shruti && bhajan.shruti !== '-' && bhajan.shruti !== 'Not specified') { %>
                <strong class="pitch-indian"><%= bhajan.shruti %></strong>
                <% if (westM !== '-') { %>
                  <span class="pitch-western">Key of <%= westM %></span>
                <% } %>
              <% } else { %>
                Not specified
              <% } %>
            </span>
          </div>
        </div>

        <!-- Female Scale / Shruti -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🎹</div>
          <div class="spec-tile-info">
            <span class="spec-label">Female Scale / Shruti</span>
            <span class="spec-value">
              <% if (bhajan.shruti_female && bhajan.shruti_female !== '-' && bhajan.shruti_female !== 'Not specified') { %>
                <strong class="pitch-indian"><%= bhajan.shruti_female %></strong>
                <% if (westF !== '-') { %>
                  <span class="pitch-western">Key of <%= westF %></span>
                <% } %>
              <% } else { %>
                <span class="muted-note">Same as male or −5 semitones</span>
              <% } %>
            </span>
          </div>
        </div>

        <!-- Deity Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🕉️</div>
          <div class="spec-tile-info">
            <span class="spec-label">Deity / Aspect</span>
            <span class="spec-value highlight-val"><%= bhajan.deity || 'Not specified' %></span>
          </div>
        </div>

        <!-- Speed / Tempo Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">⏱️</div>
          <div class="spec-tile-info">
            <span class="spec-label">Speed / Tempo</span>
            <span class="spec-value">
              <% if (bhajan.tempo) { %>
                <span class="tempo-tag-badge"><%= bhajan.tempo %></span>
              <% } else { %>
                Not specified
              <% } %>
            </span>
          </div>
        </div>

        <!-- Classical Raag Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🎵</div>
          <div class="spec-tile-info">
            <span class="spec-label">Classical Raag</span>
            <span class="spec-value"><%= (bhajan.raga && bhajan.raga !== '-' && bhajan.raga !== 'Not specified') ? bhajan.raga : 'Not specified' %></span>
          </div>
        </div>

        <% if (bhajan.raga_notes) { %>
          <!-- Dedicated Raag Singing & Swara Notes -->
          <div class="spec-tile spec-tile-full-width raga-notes-tile">
            <div class="spec-tile-icon">🎼</div>
            <div class="spec-tile-info">
              <span class="spec-label">Raag Swara Notes & Scale Details</span>
              <div class="spec-raga-notes-text"><%= bhajan.raga_notes %></div>
            </div>
          </div>
        <% } %>

        <!-- Language Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🗣️</div>
          <div class="spec-tile-info">
            <span class="spec-label">Devotional Language</span>
            <span class="spec-value"><%= bhajan.language || 'Not specified' %></span>
          </div>
        </div>

        <!-- Difficulty Level Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">📊</div>
          <div class="spec-tile-info">
            <span class="spec-label">Difficulty / Level</span>
            <span class="spec-value"><%= bhajan.level ? `Level ${bhajan.level}` : 'Standard' %></span>
          </div>
        </div>

        <!-- Master Bank ID Spec -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🆔</div>
          <div class="spec-tile-info">
            <span class="spec-label">Master Catalog ID</span>
            <span class="spec-value">#<%= bhajan.id %></span>
          </div>
        </div>

        <% if (bhajan.sheet_filename) { %>
          <!-- Official Music Sheet Reference Spec Tile -->
          <div class="spec-tile spec-tile-sheet">
            <div class="spec-tile-icon">📄</div>
            <div class="spec-tile-info">
              <span class="spec-label">Official Music Sheet</span>
              <span class="spec-value">
                <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="spec-sheet-link" title="Open <%= bhajan.sheet_filename %> in new tab">
                  <%= bhajan.sheet_filename %> ↗
                </a>
              </span>
            </div>
          </div>
        <% } %>

      </div>
    </section>

    <!-- Bottom Navigation & Action Strip -->
    <div class="detail-footer-nav no-print">
      <a href="/master-bank" class="footer-nav-btn secondary-btn">
        <span>←</span> Master Bhajan Bank
      </a>
      <button type="button" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" class="footer-nav-btn text-btn">
        <span>↑</span> Top
      </button>
    </div>

  </div>
</div>

<!-- ======================================================== -->
<!-- SONGBOOK / REPERTOIRE MODAL (PHASE 2)                    -->
<!-- ======================================================== -->
<div id="songbookModal" class="report-modal-overlay" style="display:none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; overflow-y: auto;">
  <div class="report-modal-card" style="background: #ffffff; width: 100%; max-width: 480px; border-radius: 18px; box-shadow: 0 25px 35px -5px rgba(0,0,0,0.2); overflow: hidden; max-height: 92vh; display: flex; flex-direction: column;">
    
    <!-- Modal Header -->
    <div style="padding: 20px 24px; background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%); border-bottom: 1px solid #ddd6fe; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 24px;">⭐</span>
        <div>
          <h2 style="font-size: 17px; font-weight: 800; color: #5b21b6; margin: 0;">My Singer Songbook</h2>
          <div style="font-size: 12px; color: #6d28d9; margin-top: 2px;">Bhajan: <strong><%= bhajan.title %></strong></div>
        </div>
      </div>
      <button type="button" onclick="closeSongbookModal()" style="background: transparent; border: none; font-size: 26px; cursor: pointer; color: #5b21b6; line-height: 1;">&times;</button>
    </div>

    <!-- Modal Body -->
    <div id="songbookModalBody" style="padding: 22px 24px; overflow-y: auto;">
      <div id="songbookAuthNotice" style="display: none; text-align: center; padding: 20px 10px;">
        <div style="font-size: 38px; margin-bottom: 12px;">🔒</div>
        <h3 style="font-size: 17px; font-weight: 800; color: #1e293b; margin: 0 0 8px 0;">Singer Verification Required</h3>
        <p style="font-size: 13.5px; color: #64748b; line-height: 1.5; margin: 0 0 20px 0;">
          Please sign in with your 4-digit PIN to save this bhajan to your personal Songbook repertoire and record your vocal pitch.
        </p>
        <a href="/singer/login?redirect=<%= encodeURIComponent('/bhajan/' + bhajan.id) %>" class="button primary" style="display: inline-block; padding: 10px 22px; font-weight: 700; background: #ea580c; border-color: #ea580c; text-decoration: none;">
          🎤 Singer Login with 4-Digit PIN
        </a>
      </div>

      <form id="songbookForm" onsubmit="handleSongbookFormSubmit(event)" style="display: none;">
        <input type="hidden" id="sbMasterId" value="<%= bhajan.id %>">
        
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; margin-bottom: 18px;">
          <div style="display: flex; justify-content: space-between; font-size: 13px; color: #475569; margin-bottom: 4px;">
            <span>Default Catalog Pitch:</span>
            <strong><%= bhajan.shruti || 'Not specified' %></strong>
          </div>
          <% if (bhajan.shruti_female) { %>
            <div style="display: flex; justify-content: space-between; font-size: 13px; color: #475569;">
              <span>Female Reference Pitch:</span>
              <strong><%= bhajan.shruti_female %></strong>
            </div>
          <% } %>
        </div>

        <div style="margin-bottom: 16px;">
          <label for="sbCustomScale" style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">
            My Singing Pitch / Scale
          </label>
          <input
            type="text"
            id="sbCustomScale"
            placeholder="e.g. 4.5 Safed, G#, 5 Kaali"
            value="<%= bhajan.shruti || '' %>"
            style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 14px;"
          >
          <small style="color: #64748b; font-size: 11.5px; margin-top: 4px; display: block;">
            The harmonium scale you prefer when leading this bhajan.
          </small>
        </div>

        <div style="margin-bottom: 22px;">
          <label for="sbNotes" style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">
            Personal Practice Notes (Optional)
          </label>
          <textarea
            id="sbNotes"
            rows="3"
            placeholder="e.g. Lead with slow alaap; repeat charan twice..."
            style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px; line-height: 1.4; resize: vertical;"
          ></textarea>
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
          <button type="button" id="sbRemoveBtn" onclick="handleSongbookRemove()" class="button secondary" style="color: #dc2626; border-color: #fca5a5; display: none;">
            Remove from Songbook
          </button>
          <div style="display: flex; gap: 8px; margin-left: auto;">
            <button type="button" onclick="closeSongbookModal()" class="button secondary">Cancel</button>
            <button type="submit" id="sbSaveBtn" class="button primary" style="background: #8b5cf6; border-color: #8b5cf6; font-weight: 700;">
              ⭐ Save to Songbook
            </button>
          </div>
        </div>
      </form>
    </div>

  </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: REPORT BHAJAN ISSUE / SUGGEST CORRECTION           -->
<!-- ======================================================== -->
<div id="reportModal" class="report-modal-overlay" style="display:none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; overflow-y: auto;">
  <div class="report-modal-card" style="background: #ffffff; width: 100%; max-width: 580px; border-radius: 18px; box-shadow: 0 25px 35px -5px rgba(0,0,0,0.2); overflow: hidden; max-height: 92vh; display: flex; flex-direction: column;">
    
    <!-- Modal Header -->
    <div style="padding: 20px 24px; background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-bottom: 1px solid #fed7aa; display: flex; align-items: center; justify-content: space-between;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span style="font-size: 24px;">🚩</span>
        <div>
          <h2 style="font-size: 17px; font-weight: 800; color: #9a3412; margin: 0;">Report an Issue / Suggest Correction</h2>
          <div style="font-size: 12px; color: #c2410c; margin-top: 2px;">Bhajan: <strong><%= bhajan.title %></strong></div>
        </div>
      </div>
      <button type="button" onclick="closeReportModal()" style="background: transparent; border: none; font-size: 26px; cursor: pointer; color: #9a3412; line-height: 1;">&times;</button>
    </div>

    <!-- Modal Form Body -->
    <div id="reportFormBody" style="padding: 22px 24px; overflow-y: auto; flex: 1;">
      <form id="bhajanReportForm" onsubmit="handleBhajanReportSubmit(event)">
        <input type="hidden" id="reportMasterId" value="<%= bhajan.id %>">
        <input type="hidden" id="reportBhajanTitle" value="<%= bhajan.title %>">

        <!-- Category Checkboxes -->
        <div style="margin-bottom: 18px;">
          <label style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 8px;">
            What needs to be corrected? <span style="font-weight: 400; color: #64748b;">(Select all that apply)</span>
          </label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="lyrics" checked style="accent-color: #ea580c;">
              <span>📝 Lyrics incorrect / missing</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="scale" style="accent-color: #ea580c;">
              <span>🎵 Scale / Pitch incorrect</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="raga" style="accent-color: #ea580c;">
              <span>🎼 Raga name inaccurate</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="deity" style="accent-color: #ea580c;">
              <span>🕉️ Deity categorization</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="tempo" style="accent-color: #ea580c;">
              <span>⏱️ Tempo (Speed) wrong</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="sheet" style="accent-color: #ea580c;">
              <span>📄 Music Sheet error</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="spelling" style="accent-color: #ea580c;">
              <span>✏️ Title / word typo</span>
            </label>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 12.5px; padding: 7px 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; cursor: pointer;">
              <input type="checkbox" name="reportCat" value="other" style="accent-color: #ea580c;">
              <span>❓ Other detail</span>
            </label>
          </div>
        </div>

        <!-- Description -->
        <div style="margin-bottom: 14px;">
          <label for="reportDescription" style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">
            Issue Details <span style="font-weight: 500; color: #16a34a; font-size: 12px;">(Optional — not required if option is checked above)</span>
          </label>
          <textarea
            id="reportDescription"
            rows="3"
            placeholder="Optional: No need to write anything if your issue is covered by the checkboxes above. You can add specific details here only if you wish..."
            style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13.5px; line-height: 1.4; resize: vertical;"
          ></textarea>
        </div>

        <!-- Suggested Correction / Lyrics (Optional) -->
        <div style="margin-bottom: 14px;">
          <label for="reportSuggestion" style="display: block; font-size: 13px; font-weight: 700; color: #1e293b; margin-bottom: 6px;">
            Suggested Correction / Full Lyrics <span style="font-weight: 400; color: #64748b;">(Optional)</span>
          </label>
          <textarea
            id="reportSuggestion"
            rows="3"
            placeholder="Paste verified lyrics or recommended changes here..."
            style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13.5px; line-height: 1.4; resize: vertical;"
          ></textarea>
        </div>

        <!-- Reporter Info (Optional) -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px;">
          <div>
            <label for="reporterName" style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px;">Your Name (Optional)</label>
            <input
              type="text"
              id="reporterName"
              placeholder="e.g. Prashant"
              style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;"
            >
          </div>
          <div>
            <label for="reporterContact" style="display: block; font-size: 12px; font-weight: 600; color: #475569; margin-bottom: 4px;">Contact (Email/Phone - Optional)</label>
            <input
              type="text"
              id="reporterContact"
              placeholder="For update notifications"
              style="width: 100%; padding: 8px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;"
            >
          </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; align-items: center; justify-content: flex-end; gap: 10px;">
          <button type="button" onclick="closeReportModal()" class="button secondary" style="padding: 9px 16px;">Cancel</button>
          <button type="submit" id="submitReportBtn" class="button primary" style="padding: 9px 22px; font-weight: 700; background: #ea580c; border-color: #ea580c;">🚩 Submit Report</button>
        </div>
      </form>
    </div>

    <!-- Success Confirmation State (shown after submit) -->
    <div id="reportSuccessBody" style="display: none; padding: 32px 24px; text-align: center;">
      <div style="font-size: 44px; margin-bottom: 12px;">✅</div>
      <h3 style="font-size: 20px; font-weight: 800; color: #1e293b; margin: 0 0 8px 0;">Report Submitted!</h3>
      <p style="font-size: 14px; color: #64748b; max-width: 420px; margin: 0 auto 16px auto; line-height: 1.5;">
        Thank you for helping keep our Bhajan Bank accurate. Our music and coordination team will review this.
      </p>
      
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; max-width: 320px; margin: 0 auto 20px auto;">
        <div style="font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 700;">Your Reference Ticket</div>
        <div id="createdTicketCode" style="font-family: monospace; font-size: 20px; font-weight: 800; color: #4338ca; margin-top: 4px;">REP-XXXX</div>
      </div>

      <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
        <a href="/my-reports" class="button primary" style="text-decoration: none; padding: 10px 18px; font-size: 13px; font-weight: 700;">
          📋 Track Ticket Status
        </a>
        <button type="button" onclick="closeReportModal()" class="button secondary" style="padding: 10px 18px; font-size: 13px;">
          Done
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ======================================================== -->
<!-- BULLETPROOF CLIENT SCRIPTS (FONT RESIZE, ALIGN, COPY)     -->
<!-- ======================================================== -->
<script>
(function() {
  const DEFAULT_SIZE = 20;
  const MIN_SIZE = 14;
  const MAX_SIZE = 36;
  let currentSize = DEFAULT_SIZE;

  // Restore saved preference
  try {
    const saved = localStorage.getItem('bp_bhajan_lyrics_font_size');
    if (saved) {
      const parsed = parseInt(saved, 10);
      if (!isNaN(parsed) && parsed >= MIN_SIZE && parsed <= MAX_SIZE) {
        currentSize = parsed;
      }
    }
  } catch (e) {}

  function applySize(size) {
    currentSize = Math.max(MIN_SIZE, Math.min(MAX_SIZE, size));

    // Update CSS variables on document & container
    document.documentElement.style.setProperty('--lyrics-font-size', currentSize + 'px');
    
    const container = document.getElementById('lyricsContainer');
    if (container) {
      container.style.setProperty('--lyrics-font-size', currentSize + 'px');
      container.style.fontSize = currentSize + 'px';
      
      // Enforce on all lyrics lines directly for instant, flawless rendering
      const lines = container.querySelectorAll('.lyrics-line');
      for (let i = 0; i < lines.length; i++) {
        lines[i].style.fontSize = currentSize + 'px';
      }
    }

    const display = document.getElementById('fontSizeDisplay');
    if (display) {
      display.textContent = currentSize + 'px';
      display.title = 'Current font size: ' + currentSize + 'px';
    }

    const btnDec = document.getElementById('fontDec');
    const btnInc = document.getElementById('fontInc');
    if (btnDec) btnDec.disabled = (currentSize <= MIN_SIZE);
    if (btnInc) btnInc.disabled = (currentSize >= MAX_SIZE);

    try {
      localStorage.setItem('bp_bhajan_lyrics_font_size', String(currentSize));
    } catch (e) {}
  }

  // Expose global controller
  window.changeLyricsFontSize = function(delta) {
    if (delta === 0) {
      applySize(DEFAULT_SIZE);
    } else {
      applySize(currentSize + delta);
    }
  };

  // Alignment Toggle
  let isLeftAligned = false;
  window.toggleLyricsAlignment = function() {
    isLeftAligned = !isLeftAligned;
    const container = document.getElementById('lyricsContainer');
    const alignIcon = document.getElementById('alignIcon');
    const alignText = document.getElementById('alignText');

    if (container) {
      if (isLeftAligned) {
        container.classList.add('align-left');
        if (alignIcon) alignIcon.textContent = '☱';
        if (alignText) alignText.textContent = 'Center';
      } else {
        container.classList.remove('align-left');
        if (alignIcon) alignIcon.textContent = '≡';
        if (alignText) alignText.textContent = 'Left';
      }
    }
  };

  // Copy Lyrics to Clipboard
  window.copyBhajanLyrics = async function() {
    const rawDataElem = document.getElementById('rawBhajanData');
    const lyricsElem = document.getElementById('rawLyricsText');
    const copyBtn = document.getElementById('copyLyricsBtn');
    const copyBtnText = document.getElementById('copyBtnText');
    const copyIcon = document.getElementById('copyIcon');

    if (!lyricsElem || !lyricsElem.value.trim()) return;

    const title = rawDataElem ? rawDataElem.getAttribute('data-title') : '';
    const deity = rawDataElem ? rawDataElem.getAttribute('data-deity') : '';
    const lyrics = lyricsElem.value.trim();

    const formatted = (title ? title : 'Bhajan') + (deity ? ' (' + deity + ')' : '') + '\n\n' + lyrics + '\n\n— Sri Sathya Sai Seva Organisation, Gandhinagar';

    try {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        await navigator.clipboard.writeText(formatted);
      } else {
        lyricsElem.style.display = 'block';
        lyricsElem.select();
        document.execCommand('copy');
        lyricsElem.style.display = 'none';
      }

      if (copyBtn) copyBtn.classList.add('copied');
      if (copyBtnText) copyBtnText.textContent = 'Copied! ✓';
      if (copyIcon) copyIcon.textContent = '✓';

      setTimeout(function() {
        if (copyBtn) copyBtn.classList.remove('copied');
        if (copyBtnText) copyBtnText.textContent = 'Copy Lyrics';
        if (copyIcon) copyIcon.textContent = '📋';
      }, 2200);
    } catch (err) {
      alert('Could not copy lyrics to clipboard.');
    }
  };

  // Floral Frame Toggle (Double gold border & botanical corners)
  let isFrameActive = true;
  try {
    const savedFrame = localStorage.getItem('bp_bhajan_lyrics_floral_frame');
    if (savedFrame !== null) {
      isFrameActive = (savedFrame === 'true');
    }
  } catch (e) {}

  function applyFrameState(active) {
    isFrameActive = active;
    const viewport = document.getElementById('lyricsViewport');
    const btn = document.getElementById('toggleFrameBtn');
    const icon = document.getElementById('frameIcon');
    const text = document.getElementById('frameText');
    if (viewport) {
      viewport.classList.toggle('floral-frame-active', isFrameActive);
    }
    if (btn) {
      btn.classList.toggle('active', isFrameActive);
    }
    if (icon) icon.textContent = isFrameActive ? '🌸' : '📄';
    if (text) text.textContent = isFrameActive ? 'Frame' : 'Clean';
    try {
      localStorage.setItem('bp_bhajan_lyrics_floral_frame', String(isFrameActive));
    } catch (e) {}
  }

  window.toggleFloralFrame = function() {
    applyFrameState(!isFrameActive);
  };

  // -------------------------------------------------------------
  // REPORT ISSUE / SUGGEST CORRECTION MODAL CONTROLLER
  // -------------------------------------------------------------
  window.openReportModal = function() {
    const modal = document.getElementById('reportModal');
    if (!modal) return;
    document.getElementById('reportFormBody').style.display = 'block';
    document.getElementById('reportSuccessBody').style.display = 'none';
    modal.style.display = 'flex';
  };

  window.closeReportModal = function() {
    const modal = document.getElementById('reportModal');
    if (modal) modal.style.display = 'none';
  };

  window.handleBhajanReportSubmit = async function(e) {
    e.preventDefault();
    const btn = document.getElementById('submitReportBtn');
    const masterId = document.getElementById('reportMasterId').value;
    const bhajanTitle = document.getElementById('reportBhajanTitle').value;
    const desc = document.getElementById('reportDescription').value;
    const suggestion = document.getElementById('reportSuggestion').value;
    const reporterName = document.getElementById('reporterName').value;
    const reporterContact = document.getElementById('reporterContact').value;

    const checkedCats = [];
    const catCheckboxes = document.querySelectorAll('input[name="reportCat"]:checked');
    catCheckboxes.forEach(cb => checkedCats.push(cb.value));

    if (checkedCats.length === 0 && (!desc || !desc.trim())) {
      alert('Please select at least one issue category above, or provide details in the description.');
      return;
    }

    try {
      btn.disabled = true;
      btn.textContent = 'Submitting...';

      const devId = localStorage.getItem('bp_device_id') || '';
      const res = await fetch('/api/reports/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          master_id: masterId,
          bhajan_title: bhajanTitle,
          categories: checkedCats,
          description: desc,
          suggested_correction: suggestion,
          reporter_name: reporterName,
          reporter_contact: reporterContact,
          visitor_id: devId
        })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to submit report');

      // Save ticket code into localStorage for easy tracking
      try {
        const stored = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
        if (data.ticket && data.ticket.ticket_code && !stored.includes(data.ticket.ticket_code)) {
          stored.unshift(data.ticket.ticket_code);
          localStorage.setItem('bp_my_report_tickets', JSON.stringify(stored));
        }
      } catch (_) {}

      // Show success screen
      document.getElementById('createdTicketCode').textContent = data.ticket.ticket_code;
      document.getElementById('reportFormBody').style.display = 'none';
      document.getElementById('reportSuccessBody').style.display = 'block';

      // Reset form
      document.getElementById('bhajanReportForm').reset();
    } catch (err) {
      alert('Error submitting report: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = '🚩 Submit Report';
    }
  };

  // Check if admin has responded to any past reports from this device
  async function checkReportNotifications() {
    try {
      let storedTickets = [];
      try {
        storedTickets = JSON.parse(localStorage.getItem('bp_my_report_tickets') || '[]');
      } catch (_) {}

      const devId = localStorage.getItem('bp_device_id') || '';
      if (storedTickets.length === 0 && !devId) return;

      const p = [];
      if (storedTickets.length > 0) p.push('tickets=' + encodeURIComponent(storedTickets.join(',')));
      if (devId) p.push('visitor_id=' + encodeURIComponent(devId));

      const res = await fetch('/api/reports/my-reports?' + p.join('&'));
      const data = await res.json();

      if (data && data.has_unread_reply) {
        const dot = document.getElementById('unreadReplyDot');
        if (dot) dot.style.display = 'block';
      }
    } catch (_) {}
  }

  // -------------------------------------------------------------
  // SONGBOOK / REPERTOIRE CONTROLLER (PHASE 2)
  // -------------------------------------------------------------
  let isSongbookBookmarked = false;
  let isSingerLoggedIn = false;

  async function checkSongbookStatus() {
    try {
      const res = await fetch('/api/singer/songbook/check/<%= bhajan.id %>');
      const data = await res.json();
      isSingerLoggedIn = Boolean(data.loggedIn);
      isSongbookBookmarked = Boolean(data.bookmarked);

      const btn = document.getElementById('songbookBtn');
      const icon = document.getElementById('songbookIcon');
      const text = document.getElementById('songbookBtnText');
      const removeBtn = document.getElementById('sbRemoveBtn');
      const scaleInput = document.getElementById('sbCustomScale');
      const notesInput = document.getElementById('sbNotes');

      if (isSongbookBookmarked && data.bookmark) {
        if (icon) icon.textContent = '★';
        if (text) text.textContent = 'In Songbook';
        if (btn) {
          btn.style.color = '#7c3aed';
          btn.style.borderColor = '#8b5cf6';
          btn.style.background = '#f5f3ff';
        }
        if (removeBtn) removeBtn.style.display = 'inline-block';
        if (scaleInput && data.bookmark.custom_scale) scaleInput.value = data.bookmark.custom_scale;
        if (notesInput && data.bookmark.notes) notesInput.value = data.bookmark.notes;
      } else {
        if (icon) icon.textContent = '⭐';
        if (text) text.textContent = 'Songbook';
        if (btn) {
          btn.style.background = 'transparent';
          btn.style.borderColor = 'rgba(124, 58, 237, 0.35)';
        }
        if (removeBtn) removeBtn.style.display = 'none';
      }
    } catch (_) {}
  }

  window.openSongbookModal = function() {
    const modal = document.getElementById('songbookModal');
    const authNotice = document.getElementById('songbookAuthNotice');
    const form = document.getElementById('songbookForm');

    if (!isSingerLoggedIn) {
      if (authNotice) authNotice.style.display = 'block';
      if (form) form.style.display = 'none';
    } else {
      if (authNotice) authNotice.style.display = 'none';
      if (form) form.style.display = 'block';
    }

    if (modal) modal.style.display = 'flex';
  };

  window.closeSongbookModal = function() {
    const modal = document.getElementById('songbookModal');
    if (modal) modal.style.display = 'none';
  };

  window.handleSongbookFormSubmit = async function(e) {
    e.preventDefault();
    const btn = document.getElementById('sbSaveBtn');
    const masterId = document.getElementById('sbMasterId').value;
    const customScale = document.getElementById('sbCustomScale').value;
    const notes = document.getElementById('sbNotes').value;

    try {
      btn.disabled = true;
      btn.textContent = 'Saving...';

      let endpoint = isSongbookBookmarked ? '/api/singer/songbook/update' : '/api/singer/songbook/toggle';

      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ master_id: masterId, custom_scale: customScale, notes: notes })
      });

      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save');

      await checkSongbookStatus();
      closeSongbookModal();
    } catch (err) {
      alert('Error: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = '⭐ Save to Songbook';
    }
  };

  window.handleSongbookRemove = async function() {
    if (!confirm('Remove this bhajan from your Songbook?')) return;
    try {
      const res = await fetch('/api/singer/songbook/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ master_id: '<%= bhajan.id %>' })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to remove');

      await checkSongbookStatus();
      closeSongbookModal();
    } catch (err) {
      alert('Error: ' + err.message);
    }
  };

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() { 
      applySize(currentSize);
      applyFrameState(isFrameActive);
      checkReportNotifications();
      checkSongbookStatus();
    });
  } else {
    applySize(currentSize);
    applyFrameState(isFrameActive);
    checkReportNotifications();
    checkSongbookStatus();
  }
})();
</script>


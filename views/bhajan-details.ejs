      </div>

      <div class="meta-specs-grid">
        
        <!-- Male Scale / Shruti -->
        <div class="spec-tile">
          <div class="spec-tile-icon">🎹</div>
          <div class="spec-tile-info">
            <span class="spec-label">Male Scale / Shruti</span>

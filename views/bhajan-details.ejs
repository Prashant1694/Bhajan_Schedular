<%
  function getWesternScale(indianScale) {
    if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
    const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
    if (!match) return '-';
    const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
    if (numMap[match[1]] === undefined) return '-';
    let index = numMap[match[1]];
    if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12;
    return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
  }

  const hasLyrics = bhajan.lyrics && bhajan.lyrics.trim().length > 0;
  const westM = getWesternScale(bhajan.shruti);
  const westF = getWesternScale(bhajan.shruti_female);

  // Split lyrics into paragraphs/stanzas
  const stanzas = hasLyrics 
    ? bhajan.lyrics.trim().split(/\r?\n\s*\r?\n/).filter(Boolean)
    : [];

  // Calculate total non-empty lyrics lines for dynamic full-frame print layout
  const totalLyricsLines = stanzas.reduce((acc, st) => {
    return acc + st.split(/\r?\n/).filter(l => l.trim().length > 0).length;
  }, 0);

  let printDensityClass = 'print-spacious';
  if (totalLyricsLines > 22) {
    printDensityClass = 'print-compact';
  } else if (totalLyricsLines > 13) {
    printDensityClass = 'print-medium';
  }
%>

<div class="bhajan-detail-page <%= printDensityClass %>">
  <div class="container detail-container">

    <!-- Top Breadcrumb & Navigation -->
    <nav class="detail-nav-bar" aria-label="Breadcrumb navigation">
      <a href="/master-bank" class="detail-back-btn" id="backToBankBtn">
        <span class="back-arrow">←</span> Master Bhajan Bank
      </a>
      <div class="detail-breadcrumbs">
        <a href="/master-bank">Master Bank</a>
        <span class="crumb-sep">/</span>
        <% if (bhajan.deity) { %>
          <span class="crumb-deity"><%= bhajan.deity %></span>
          <span class="crumb-sep">/</span>
        <% } %>
        <span class="crumb-current" title="<%= bhajan.title %>"><%= bhajan.title %></span>
      </div>
    </nav>

    <!-- Sacred Header Card -->
    <header class="detail-hero-card">
      <div class="detail-hero-content">
        <h1 class="detail-bhajan-title" id="bhajanTitleDisplay"><%= bhajan.title %></h1>
        <div class="detail-badge-strip">
          <% if (bhajan.deity) { %>
            <% bhajan.deity.split(',').map(d => d.trim()).filter(Boolean).forEach(d => { %>
              <span class="hero-pill deity-pill">🕉️ <%= d %></span>
            <% }); %>
          <% } %>
          <% if (bhajan.tempo) { %>
            <span class="hero-pill tempo-pill">⏱️ <%= bhajan.tempo %></span>
          <% } %>
          <% if (bhajan.raga && bhajan.raga !== '-' && bhajan.raga !== 'Not specified') { %>
            <span class="hero-pill raga-pill">🎼 Raag <%= bhajan.raga %></span>
          <% } %>
          <% if (bhajan.language) { %>
            <span class="hero-pill lang-pill">🗣️ <%= bhajan.language %></span>
          <% } %>
          <% if (bhajan.sheet_filename) { %>
            <a href="/sheets/<%= encodeURIComponent(bhajan.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="hero-pill sheet-pill" title="Open official PDF music notation & sheet">
              📄 Music Sheet ↗

<div class="session-unified-page">

  <!-- Toast Notification Container -->
  <div id="catcherToast" style="display:none; position:fixed; top:24px; right:24px; z-index:9999; background:linear-gradient(135deg, #16a34a, #15803d); color:#fff; padding:12px 22px; border-radius:12px; font-size:13.5px; font-weight:700; box-shadow:0 8px 24px rgba(0,0,0,0.2); transition:all 0.3s ease;">
  </div>

  <!-- ═══ EXECUTIVE HEADER ═══ -->
  <header class="session-unified-header">
    <div class="session-header-top-row">
      <div class="session-header-identity">
        <div class="session-date-tile" style="background:linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(217, 138, 43, 0.15)); border-color:rgba(239, 68, 68, 0.4);">
          <span style="font-size:22px;">🚨</span>
        </div>
        <div class="session-title-block">
          <h1>Missing Bhajan Catcher</h1>
          <div class="session-tags-row">
            <span class="session-tag <%= totalMissing === 0 ? 'session-tag-regular' : 'session-tag-festival' %>">
              <%= totalMissing === 0 ? '✅ 100% Synchronized' : `${totalMissing} Unlinked Submissions` %>
            </span>
            <% if (totalPages > 1) { %>
              <span class="session-tag session-tag-regular">Batch <%= currentPage %> of <%= totalPages %> (50 / batch)</span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Nav Buttons -->
      <div class="session-primary-actions" style="max-width:320px;">
        <a href="/master-bank" class="sec-tool-btn" style="height:42px; min-height:42px; flex-direction:row; gap:6px;">
          <span>📚</span>
          <span>Master Bank</span>
        </a>
        <a href="/admin" class="sec-tool-btn" style="height:42px; min-height:42px; flex-direction:row; gap:6px;">
          <span>🏠</span>
          <span>Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Metrics Deck -->
    <div class="session-metrics-deck" style="margin-top:14px;">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-card-icon">🚨</div>
          <div class="metric-card-data">
            <span class="metric-card-val total-missing-count"><%= totalMissing %></span>
            <span class="metric-card-lbl">Missing From Master</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon">⚡</div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= missingBhajans ? missingBhajans.length : 0 %></span>
            <span class="metric-card-lbl">In Current Batch</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon">📄</div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= currentPage %> / <%= totalPages || 1 %></span>
            <span class="metric-card-lbl">Batch Page</span>
          </div>
        </div>
        <div class="metric-card">
          <div class="metric-card-icon">🔍</div>
          <div class="metric-card-data">
            <span class="metric-card-val"><%= missingBhajans ? missingBhajans.filter(b => b.candidates && b.candidates.length > 0).length : 0 %></span>
            <span class="metric-card-lbl">With Auto-Matches</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ MAIN WORKSPACE ═══ -->
  <main class="session-unified-workspace view-mode-table">

    <!-- Workspace Controls Bar -->
    <div class="workspace-header-bar">
      <div class="workspace-filter-box">
        <input type="text" id="missingSearchInput" onkeyup="filterMissingBhajans()"
               placeholder="🔍 Filter this batch of <%= missingBhajans ? missingBhajans.length : 0 %> bhajans..." 
               class="workspace-search-input" aria-label="Filter missing bhajans">
        
        <span class="workspace-meta-text">
          Showing #<%= startIndex %> to #<%= endIndex %> of <%= totalMissing %>
        </span>
      </div>

      <!-- Pagination Buttons -->
      <% if (totalPages > 1) { %>
        <div class="workspace-view-controls">
          <div style="display:flex; gap:6px;">
            <% if (hasPrev) { %>
              <a href="/admin/missing-bhajans?page=<%= currentPage - 1 %>" class="sec-tool-btn" style="width:auto; min-height:34px; padding:0 12px; flex-direction:row; gap:4px;">
                ← Prev 50
              </a>
            <% } %>
            <% if (hasNext) { %>
              <a href="/admin/missing-bhajans?page=<%= currentPage + 1 %>" class="sec-tool-btn" style="width:auto; min-height:34px; padding:0 12px; flex-direction:row; gap:4px;">
                Next 50 →
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Missing Bhajans Cards Container -->
    <div class="workspace-cards-list">
      <% if (missingBhajans && missingBhajans.length > 0) { %>
        <div id="missingListContainer" class="cards-deck-container">
          <% missingBhajans.forEach(function(item, idx) { %>
            <article class="sequencer-card missing-card-item" id="card-<%= encodeURIComponent(item.submittedTitle) %>" data-title="<%= item.submittedTitle.toLowerCase() %>">
              
              <!-- Card Header -->
              <div class="card-top-header" style="align-items:center;">
                <div class="card-reorder-group">
                  <span class="table-order-badge" style="cursor:default; min-width:32px; height:32px; font-size:12px;">
                    #<%= startIndex + idx %>
                  </span>
                </div>
                <div class="card-header-main">
                  <div class="card-title-wrap">
                    <span class="card-bhajan-title" style="font-size:16px;">📝 <%= item.submittedTitle %></span>
                  </div>
                </div>
              </div>

              <!-- Candidate Auto-Matches -->
              <% if (item.candidates && item.candidates.length > 0) { %>
                <div style="font-size:12px; font-weight:700; color:var(--text-light); display:flex; align-items:center; gap:6px; margin-top:2px;">
                  <span>🔍</span> Potential matches found in Master Database:
                </div>

                <div style="display:flex; flex-direction:column; gap:8px;">
                  <% item.candidates.forEach(function(c) { %>
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px; background:var(--surface-raised); border:1px solid var(--border); border-radius:10px; padding:10px 14px;">
                      <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; flex:1;">
                        <span class="card-deity-pill" style="font-size:11px;">
                          <%= c.master.deity %>
                        </span>
                        <strong style="font-size:14px; color:var(--text);"><%= c.master.title %></strong>
                        <% if (c.master.raga) { %>
                          <span style="font-size:11.5px; color:var(--text-light);">• Raag: <%= c.master.raga %></span>
                        <% } %>
                        <span class="diag-chip pass" style="font-size:10.5px; padding:2px 7px;">
                          <%= Math.round(c.score * 100) %>% match
                        </span>
                      </div>

                      <button type="button" class="cmd-btn cmd-btn-share" style="height:32px; font-size:12px; padding:0 14px;"
                              onclick="liveReconcile('<%= item.submittedTitle.replace(/'/g, "\\'") %>', 'link', <%= c.master.id %>, '<%= c.master.title.replace(/'/g, "\\'") %>')">
                        ✓ Yes, Link This
                      </button>
                    </div>
                  <% }); %>
                </div>

                <div style="display:flex; justify-content:flex-end; align-items:center; gap:8px; margin-top:4px;">
                  <span style="font-size:12px; color:var(--text-light);">None of these match?</span>
                  <button type="button" class="card-touch-btn btn-edit" onclick="openMissingBhajanModal('<%= item.submittedTitle.replace(/'/g, "\\'") %>')">
                    ➕ Add as New Canonical Song
                  </button>
                </div>

              <% } else { %>
                <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; background:var(--surface-raised); padding:10px 14px; border-radius:10px; border:1px solid var(--border-soft);">
                  <span style="font-size:12.5px; color:var(--text-light);">No similar titles found in Master Bank.</span>
                  <button type="button" class="cmd-btn cmd-btn-add" style="height:34px; font-size:12.5px; padding:0 16px;"
                          onclick="openMissingBhajanModal('<%= item.submittedTitle.replace(/'/g, "\\'") %>')">
                    ➕ Add to Master Bank
                  </button>
                </div>
              <% } %>

            </article>
          <% }); %>
        </div>

      <% } else { %>
        <div style="padding:48px 20px; text-align:center;">
          <div style="font-size:42px; margin-bottom:12px;">🎉</div>
          <h3 style="margin:0 0 8px 0; font-size:18px; font-weight:700;">100% Synchronized!</h3>
          <p style="font-size:13.5px; color:var(--text-light); margin:0;">
            Every single bhajan submitted in past sessions matches a canonical record in the Master Database.
          </p>
        </div>
      <% } %>
    </div>

  </main>

  <!-- ═══ ADD MISSING BHAJAN MODAL ═══ -->
  <div id="missingBhajanModal" class="session-modal-overlay">
    <div class="session-modal-card" style="max-width:480px;">
      <div class="session-modal-header">
        <h3>➕ Add to Master Database</h3>
        <button type="button" class="sec-tool-btn" style="width:30px; min-height:30px; padding:0; border-radius:50%;" onclick="closeMissingBhajanModal()">✕</button>
      </div>
      <div class="session-modal-body" style="display:flex; flex-direction:column; gap:12px;">
        <div>
          <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Bhajan Title</label>
          <input type="text" id="mbTitle" required class="workspace-search-input" style="width:100%; max-width:none;">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Deity</label>
            <select id="mbDeity" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Ganesha">Ganesha</option>
              <option value="Guru">Guru</option>
              <option value="Mata">Mata / Devi</option>
              <option value="SarvaDharma">SarvaDharma</option>
              <option value="Sai">Sai</option>
              <option value="Shiva">Shiva</option>
              <option value="Krishna">Krishna</option>
              <option value="Rama">Rama</option>
              <option value="Narayana">Narayana</option>
              <option value="Vitthala">Vitthala</option>
              <option value="Hanuman">Hanuman</option>
            </select>
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Tempo</label>
            <select id="mbTempo" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Medium">Medium</option>
              <option value="Slow">Slow</option>
              <option value="Fast">Fast</option>
            </select>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Scale (Male)</label>
            <input type="text" id="mbShruti" placeholder="e.g. 4 White" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Scale (Female)</label>
            <input type="text" id="mbShrutiFemale" placeholder="e.g. 1 White" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Raag</label>
            <input type="text" id="mbRaga" placeholder="e.g. Bhairavi" class="workspace-search-input" style="width:100%; max-width:none;">
          </div>
          <div>
            <label style="display:block; font-size:12px; font-weight:700; margin-bottom:4px; color:var(--text);">Difficulty Level</label>
            <select id="mbLevel" class="workspace-search-input" style="width:100%; max-width:none;">
              <option value="Easy">Easy</option>
              <option value="Medium" selected>Medium</option>
              <option value="Hard">Hard</option>
            </select>
          </div>
        </div>
      </div>
      <div class="session-modal-footer">
        <button type="button" class="sec-tool-btn" style="width:auto; min-height:36px; padding:0 14px;" onclick="closeMissingBhajanModal()">Cancel</button>
        <button type="button" class="cmd-btn cmd-btn-share" style="height:36px; padding:0 18px;" onclick="liveSaveMissingBhajan()">Add to Master</button>
      </div>
    </div>
  </div>

</div>

<script>
  function showToast(message, type = 'success') {
    const toast = document.getElementById('catcherToast');
    if (!toast) return;
    toast.textContent = message;
    toast.style.background = type === 'error' ? 'linear-gradient(135deg, #dc2626, #b91c1c)' : 'linear-gradient(135deg, #16a34a, #15803d)';
    toast.style.display = 'block';
    toast.style.opacity = '1';
    setTimeout(() => {
      toast.style.opacity = '0';
      setTimeout(() => toast.style.display = 'none', 300);
    }, 3500);
  }

  function liveRemoveCard(submittedTitle) {
    const cardId = 'card-' + encodeURIComponent(submittedTitle);
    const card = document.getElementById(cardId);
    if (card) {
      card.style.transition = 'all 0.35s cubic-bezier(0.4, 0, 0.2, 1)';
      card.style.opacity = '0';
      card.style.transform = 'translateY(-10px) scale(0.97)';
      setTimeout(() => {
        card.style.maxHeight = '0';
        card.style.padding = '0';
        card.style.margin = '0';
        card.style.overflow = 'hidden';
        card.style.border = 'none';
      }, 150);
      setTimeout(() => {
        card.remove();
        decrementAllCounters();
      }, 380);
    }
  }

  function decrementAllCounters() {
    const countElems = document.querySelectorAll('.total-missing-count, .missing-catcher-badge');
    countElems.forEach(el => {
      let current = parseInt(el.textContent.replace(/[^\d]/g, ''), 10);
      if (!isNaN(current) && current > 0) {
        let updated = current - 1;
        el.textContent = updated > 999 ? '999+' : (updated > 0 ? updated : '');
        if (updated <= 0) {
          el.style.display = 'none';
          const dot = document.querySelector('.sidebar-badge-dot');
          if (dot) dot.style.display = 'none';
        }
      }
    });

    const remaining = document.querySelectorAll('.missing-card-item');
    if (remaining.length === 0) {
      const container = document.getElementById('missingListContainer');
      if (container) {
        container.innerHTML = `
          <div style="background:var(--surface); border:1px solid var(--border); border-radius:14px; padding:40px 20px; text-align:center;">
            <div style="font-size:42px; margin-bottom:12px;">🎉</div>
            <h3 style="color:var(--success); margin-bottom:8px;">Batch Completed!</h3>
            <p style="color:var(--text-light); margin-bottom:18px;">All 50 bhajans in this batch have been reconciled.</p>
            <a href="/admin/missing-bhajans" class="cmd-btn cmd-btn-share" style="display:inline-flex; text-decoration:none; height:38px; padding:0 22px;">
              Continue to Next Batch →
            </a>
          </div>
        `;
      }
    }
  }

  function liveReconcile(submittedTitle, action, masterBhajanId, masterTitle) {
    fetch('/api/admin/reconcile-bhajan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ submitted_title: submittedTitle, action, master_bhajan_id: masterBhajanId })
    })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          showToast('✓ Linked "' + submittedTitle + '" to "' + (masterTitle || data.masterTitle || '') + '"');
          liveRemoveCard(submittedTitle);
        } else {
          showToast('Error: ' + (data.error || 'Unknown error'), 'error');
        }
      })
      .catch(err => showToast('Request failed: ' + err.message, 'error'));
  }

  function openMissingBhajanModal(title) {
    document.getElementById('mbTitle').value = title;
    document.getElementById('missingBhajanModal').classList.add('show');
  }

  function closeMissingBhajanModal() {
    document.getElementById('missingBhajanModal').classList.remove('show');
  }

  function liveSaveMissingBhajan() {
    const title = document.getElementById('mbTitle').value;
    const data = {
      title: title,
      deity: document.getElementById('mbDeity').value,
      tempo: document.getElementById('mbTempo').value,
      raga: document.getElementById('mbRaga').value,
      shruti: document.getElementById('mbShruti').value,
      shruti_female: document.getElementById('mbShrutiFemale').value,
      level: document.getElementById('mbLevel').value
    };

    fetch('/api/add-master-bhajan', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
      .then(res => res.json())
      .then(result => {
        if (result.success) {
          closeMissingBhajanModal();
          showToast('✅ Added "' + title + '" to Master Database!');
          liveRemoveCard(title);
        } else {
          showToast('Error: ' + (result.error || 'Failed to add'), 'error');
        }
      })
      .catch(err => showToast('Request failed: ' + err.message, 'error'));
  }

  function filterMissingBhajans() {
    const query = (document.getElementById('missingSearchInput').value || '').toLowerCase().trim();
    const cards = document.querySelectorAll('.missing-card-item');
    cards.forEach(card => {
      const title = card.getAttribute('data-title') || '';
      if (!query || title.includes(query)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>
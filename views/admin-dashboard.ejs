<div class="container container-xl admin-dashboard-container">

    <!-- ═══ ADMIN PAGE HERO ═══ -->
    <div class="admin-page-hero">
        <div class="admin-hero-content">
            <div class="admin-hero-title-group">
                <div class="admin-hero-icon-bubble">🗓️</div>
                <div>
                    <h1>Session Calendar</h1>
                    <p>Schedule devotional sessions, set festival bhajans, and manage singer line-ups</p>
                </div>
            </div>
            <div class="admin-hero-actions">
                <a href="/submit-form?admin=true" class="button primary admin-hero-btn">
                    <span>➕</span> New Entry
                </a>
                <a href="/plan-view" class="button secondary admin-hero-btn">
                    <span>📤</span> Live Plan
                </a>
            </div>
        </div>
    </div>

    <!-- ═══ CALENDAR WRAPPER ═══ -->
    <div class="calendar-wrapper">
        <div class="calendar-header">
            <a
                href="/admin?month=<%= prevMonth %>&year=<%= prevYear %>"
                class="calendar-nav-btn"
                aria-label="Previous month"
                title="Previous month"
            >
                ‹
            </a>

            <div class="calendar-title-wrap">
                <h2 class="calendar-title"><%= currentMonthName %> <%= year %></h2>
                <a href="/admin" class="calendar-today-btn" title="Jump to current month">Today</a>
            </div>

            <a
                href="/admin?month=<%= nextMonth %>&year=<%= nextYear %>"
                class="calendar-nav-btn"
                aria-label="Next month"
                title="Next month"
            >
                ›
            </a>
        </div>

        <div class="calendar-weekdays">
            <%- calendarHeadersHtml %>
        </div>

        <div class="calendar-grid">
            <%- calendarCells %>
        </div>

        <!-- ═══ CALENDAR LEGEND ═══ -->
        <div class="calendar-legend">
            <div class="legend-item">
                <span class="legend-color day-thursday"></span> Regular Thursday
            </div>
            <div class="legend-item">
                <span class="legend-color day-special"></span> Special Bhajan
            </div>
            <div class="legend-item">
                <span class="legend-color day-festival"></span> Festival Session
            </div>
            <div class="legend-item">
                <span class="legend-color day-today"></span> Today
            </div>
        </div>

        <div class="calendar-hint">
            💡 Tap any date cell to configure session type, view scheduled line-ups, or add Special/Festival status.
        </div>
    </div>
</div>

<!-- ===========================
     ADMIN DATE MODAL
=========================== -->
<div id="adminDateModal" class="modal">
    <div class="modal-content admin-modal-card" style="max-width:380px;">
        <div class="modal-header">
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:20px;">📅</span>
                <h3 id="adminModalDate" style="margin:0; font-size:17px; font-weight:700;">Manage Date</h3>
            </div>
            <button class="close-btn" onclick="closeAdminModal()" aria-label="Close modal">&times;</button>
        </div>

        <div class="modal-body" style="padding:16px 0 0 0;">
            <div class="modal-field" style="margin-bottom:16px;">
                <label for="permDescription" style="display:block; margin-bottom:6px; font-size:12.5px; font-weight:600; color:var(--text);">
                    Session Description / Occasion <span style="color:var(--danger, #ef4444);">*</span>
                </label>
                <input
                    type="text"
                    id="permDescription"
                    placeholder="e.g. Mahashivratri, New Year, Akhand Bhajan"
                    maxlength="100"
                    style="width:100%; padding:10px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text); font-family:inherit; font-size:13.5px;"
                >
            </div>

            <div class="admin-modal-action-grid" style="display:grid; gap:10px;">
                <button
                    onclick="updatePermission('special')"
                    class="button"
                    style="background:#0284c7; color:#fff; border:none; display:flex; align-items:center; justify-content:center; gap:8px; font-weight:600; padding:11px;"
                >
                    <span>✨</span> Mark Special Bhajan
                </button>

                <button
                    onclick="updatePermission('festival')"
                    class="button"
                    style="background:#ea580c; color:#fff; border:none; display:flex; align-items:center; justify-content:center; gap:8px; font-weight:600; padding:11px;"
                >
                    <span>🪔</span> Mark Festival Bhajan
                </button>

                <button
                    onclick="updatePermission('clear')"
                    class="button secondary"
                    style="display:flex; align-items:center; justify-content:center; gap:8px; padding:10px;"
                >
                    <span>❌</span> Clear Special Status
                </button>

                <div style="border-top:1px solid var(--border-soft); margin:6px 0;"></div>

                <button
                    onclick="viewAdminDate()"
                    class="button primary"
                    style="display:flex; align-items:center; justify-content:center; gap:8px; padding:11px; font-weight:700;"
                >
                    <span>📋</span> View &amp; Edit Session Plan
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===========================
     MISSING BHAJAN MODAL
=========================== -->
<div id="missingBhajanModal" class="modal">
    <div class="modal-content admin-modal-card" style="max-width:440px;">
        <div class="modal-header">
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:20px;">📚</span>
                <h3 style="margin:0; font-size:17px; font-weight:700;">Add to Master Database</h3>
            </div>
            <button class="close-btn" onclick="closeMissingBhajanModal()" aria-label="Close modal">&times;</button>
        </div>

        <div style="display:flex; flex-direction:column; gap:14px; margin-top:16px;">
            <div>
                <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                    Bhajan Title
                </label>
                <input
                    type="text"
                    id="mbTitle"
                    readonly
                    style="width:100%; padding:9px 12px; border:1px solid var(--border); background:var(--bg); color:var(--text); border-radius:8px; font-weight:600;"
                >
            </div>

            <div>
                <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                    Deity
                </label>
                <select
                    id="mbDeity"
                    style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                >
                    <option value="Ganesha">Ganesha</option>
                    <option value="Guru">Guru</option>
                    <option value="Mata">Mata</option>
                    <option value="SarvaDharma">SarvaDharma</option>
                    <option value="Sai">Sai</option>
                    <option value="Shiva">Shiva</option>
                    <option value="Krishna">Krishna</option>
                    <option value="Rama">Rama</option>
                    <option value="Narayana">Narayana</option>
                    <option value="Vitthala">Vitthala</option>
                    <option value="Hanuman">Hanuman</option>
                </select>
            </div>

            <div>
                <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                    Tempo (Speed)
                </label>
                <select
                    id="mbTempo"
                    style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                >
                    <option value="Slow">Slow</option>
                    <option value="Medium">Medium</option>
                    <option value="Fast">Fast</option>
                </select>
            </div>

            <div>
                <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                    Raga
                </label>
                <input
                    type="text"
                    id="mbRaga"
                    placeholder="e.g. Yaman Kalyani, Bhairavi"
                    style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                >
            </div>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
                <div>
                    <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                        Shruti (Male)
                    </label>
                    <input
                        type="text"
                        id="mbShrutiMale"
                        placeholder="e.g. C#"
                        style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                    >
                </div>

                <div>
                    <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                        Shruti (Female)
                    </label>
                    <input
                        type="text"
                        id="mbShrutiFemale"
                        placeholder="e.g. G#"
                        style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                    >
                </div>
            </div>

            <div>
                <label style="font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">
                    Level
                </label>
                <select
                    id="mbLevel"
                    style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);"
                >
                    <option value="">Unknown</option>
                    <option value="Easy">Easy</option>
                    <option value="Medium">Medium</option>
                    <option value="Advanced">Advanced</option>
                </select>
            </div>

            <button
                class="button primary"
                onclick="saveMissingBhajan()"
                style="margin-top:6px; padding:11px; font-weight:700;"
            >
                Save to Master DB
            </button>
        </div>
    </div>
</div>

<!-- ===========================
     COPY SESSION MODAL
=========================== -->
<div id="copySessionModal" class="modal">
    <div class="modal-content admin-modal-card" style="max-width:400px;">
        <div class="modal-header">
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:20px;">📋</span>
                <h3 style="margin:0; font-size:17px; font-weight:700;">Copy Session Plan</h3>
            </div>
            <button class="close-btn" onclick="closeCopySessionModal()" aria-label="Close modal">&times;</button>
        </div>
        <div class="modal-body" style="padding:16px 0 0 0; display:flex; flex-direction:column; gap:14px;">
            <div class="modal-field">
                <label style="display:block; margin-bottom:6px; font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">Copy FROM Date</label>
                <input type="date" id="copySourceDate" style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);">
            </div>
            <div class="modal-field">
                <label style="display:block; margin-bottom:6px; font-size:12px; font-weight:600; color:var(--text-light); text-transform:uppercase;">Copy TO Date</label>
                <input type="date" id="copyTargetDate" style="width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:8px; background:var(--bg-input, var(--surface)); color:var(--text);">
            </div>
            <div class="modal-actions" style="display:flex; gap:10px; margin-top:8px;">
                <button class="button primary" onclick="submitCopySession()" style="flex:1; padding:10px; font-weight:600;">Copy Bhajans</button>
                <button class="button secondary" onclick="closeCopySessionModal()" style="padding:10px;">Cancel</button>
            </div>
        </div>
    </div>
</div>

<%
    const uniqueDeities = [...new Set(bhajans.map(b => b.deity).filter(Boolean))].sort();
    const uniqueTempos = [...new Set(bhajans.map(b => b.tempo).filter(Boolean))].sort();
    const uniqueRagas = [...new Set(bhajans.map(b => b.raga).filter(Boolean))].sort();

    function getWesternScale(indianScale) {
      if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
      const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
      if (!match) return '-';
      const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
      if (numMap[match[1]] === undefined) return '-';
      let index = numMap[match[1]];
      if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12; // 4th note mapping
      return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
    }
  %>
  <div class="container container-xl">
    <div class="header"><h1>📖 Master Bhajan Bank</h1><p>Search and Learn</p></div>

    <div class="bank-body">

      <!-- Page toolbar: title context + primary actions, separated from search/filters -->
      <div class="page-toolbar">
        <div class="toolbar-heading">
          <h1><%= bhajans.length %> Bhajans</h1>
          <p>Browse the full Prashanthi Mandir bhajan database</p>
        </div>
        <div class="toolbar-actions">
          <a href="<%= isAdmin ? '/admin' : '/' %>" class="button secondary">⬅️ Back</a>
          <% if (isAdmin) { %>
            <a href="/admin/export-master" class="button">⬇️ Download Clean JSON</a>
          <% } %>
        </div>
      </div>

      <!-- Search: its own prominent field, not sharing a row with the filters -->
      <div class="search-field">
        <span class="search-icon">🔍</span>
        <input
          type="search"
          id="filterBankTitle"
          onkeyup="if(event.key === 'Enter'){ filterMasterBank(true); this.blur(); } else { filterMasterBank(); }"
          onkeydown="if(event.key === 'Enter'){ event.preventDefault(); filterMasterBank(true); this.blur(); }"
          placeholder="Search by title…"
          autocomplete="off"
          enterkeyhint="search"
        >
      </div>

      <!-- Filters: a distinct strip below search with interactive searchable dropdowns -->
      <div class="filter-bar" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
        <span class="filter-bar-label">Filter:</span>
        
        <!-- Searchable Deity Dropdown -->
        <input type="hidden" id="filterBankDeity" value="" onchange="filterMasterBank()">
        <div class="searchable-dropdown" id="dd-deity" style="position:relative;">
          <button type="button" class="filter-chip dd-toggle" onclick="toggleSearchDropdown('dd-deity')">
            <span class="dd-label">All Deities</span> ▾
          </button>
          <div class="dd-menu" style="display:none; position:fixed; z-index:9999; width:220px; padding:8px; max-height:300px; overflow:auto;">
            <input type="search" class="dd-search filter-input" placeholder="🔍 Search deity..." onkeyup="if(event.key==='Enter'){this.blur();}else{filterDropdownOptions('dd-deity');}" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}" enterkeyhint="search" style="width:100%; padding:6px 10px; font-size:12px; margin-bottom:6px; box-sizing:border-box;">
            <div class="dd-options" style="max-height:180px; overflow-y:auto;">
              <div class="dd-option selected" data-val="" onclick="selectDropdownOption('dd-deity', '', 'All Deities')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;">All Deities</div>
              <% uniqueDeities.forEach(d => { %>
                <div class="dd-option" data-val="<%= d %>" onclick="selectDropdownOption('dd-deity', '<%= d.replace(/'/g, "\\'") %>', '<%= d.replace(/'/g, "\\'") %>')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;"><%= d %></div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Searchable Tempo Dropdown -->
        <input type="hidden" id="filterBankTempo" value="" onchange="filterMasterBank()">
        <div class="searchable-dropdown" id="dd-tempo" style="position:relative;">
          <button type="button" class="filter-chip dd-toggle" onclick="toggleSearchDropdown('dd-tempo')">
            <span class="dd-label">All Tempos</span> ▾
          </button>
          <div class="dd-menu" style="display:none; position:fixed; z-index:9999; width:200px; padding:8px; max-height:300px; overflow:auto;">
            <input type="search" class="dd-search filter-input" placeholder="🔍 Search tempo..." onkeyup="if(event.key==='Enter'){this.blur();}else{filterDropdownOptions('dd-tempo');}" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}" enterkeyhint="search" style="width:100%; padding:6px 10px; font-size:12px; margin-bottom:6px; box-sizing:border-box;">
            <div class="dd-options" style="max-height:180px; overflow-y:auto;">
              <div class="dd-option selected" data-val="" onclick="selectDropdownOption('dd-tempo', '', 'All Tempos')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;">All Tempos</div>
              <% uniqueTempos.forEach(t => { %>
                <div class="dd-option" data-val="<%= t %>" onclick="selectDropdownOption('dd-tempo', '<%= t.replace(/'/g, "\\'") %>', '<%= t.replace(/'/g, "\\'") %>')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;"><%= t %></div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Searchable Raga Dropdown -->
        <input type="hidden" id="filterBankRaga" value="" onchange="filterMasterBank()">
        <div class="searchable-dropdown" id="dd-raga" style="position:relative;">
          <button type="button" class="filter-chip dd-toggle" onclick="toggleSearchDropdown('dd-raga')">
            <span class="dd-label">All Ragas</span> ▾
          </button>
          <div class="dd-menu" style="display:none; position:fixed; z-index:9999; width:240px; padding:8px; max-height:300px; overflow:auto;">
            <input type="search" class="dd-search filter-input" placeholder="🔍 Search raga..." onkeyup="if(event.key==='Enter'){this.blur();}else{filterDropdownOptions('dd-raga');}" onkeydown="if(event.key==='Enter'){event.preventDefault();this.blur();}" enterkeyhint="search" style="width:100%; padding:6px 10px; font-size:12px; margin-bottom:6px; box-sizing:border-box;">
            <div class="dd-options" style="max-height:180px; overflow-y:auto;">
              <div class="dd-option selected" data-val="" onclick="selectDropdownOption('dd-raga', '', 'All Ragas')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;">All Ragas</div>
              <% uniqueRagas.forEach(r => { %>
                <div class="dd-option" data-val="<%= r %>" onclick="selectDropdownOption('dd-raga', '<%= r.replace(/'/g, "\\'") %>', '<%= r.replace(/'/g, "\\'") %>')" style="padding:6px 10px; font-size:13px; border-radius:6px; cursor:pointer;"><%= r %></div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="table-container bank-table">
      <table id="masterBankTable">
        <thead>
          <tr>
            <th onclick="sortTable(0, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Title ↕</th>
            <th onclick="sortTable(1, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Deity ↕</th>
            <th onclick="sortTable(2, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Tempo ↕</th>
            <th onclick="sortTable(3, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Raga ↕</th>
            <th onclick="sortTable(4, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Scale (Male) ↕</th>
            <th onclick="sortTable(5, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">West (M) ↕</th>
            <th onclick="sortTable(6, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Scale (Female) ↕</th>
            <th onclick="sortTable(7, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">West (F) ↕</th>
            <th onclick="sortTable(8, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Level ↕</th>
            <th onclick="sortTable(9, 'masterBankTable')" style="cursor:pointer;" title="Click to sort">Language ↕</th>
            <% if (isAdmin) { %><th>Actions</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (bhajans.length > 0) { %>
            <% bhajans.forEach(b => { %>
              <tr id="row-<%= b.id %>" data-deity="<%= (b.deity || '').toLowerCase() %>">
                <td data-label="Title" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="title"><%= b.title %></td>
                <td data-label="Deity" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="deity"><span class="deity-pill"><%= b.deity || '-' %></span></td>
                <td data-label="Tempo" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="tempo"><%= b.tempo || '-' %></td>
                <td data-label="Raga" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="raga"><%= b.raga || '-' %></td>
                <td data-label="Scale (M)" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="shruti"><%= b.shruti || '-' %></td>
                <td data-label="West (M)" id="west-m-<%= b.id %>" style="color:#8b8394; font-weight:600;"><%= getWesternScale(b.shruti) %></td>
                <td data-label="Scale (F)" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="shruti_female"><%= b.shruti_female || '-' %></td>
                <td data-label="West (F)" id="west-f-<%= b.id %>" style="color:#8b8394; font-weight:600;"><%= getWesternScale(b.shruti_female) %></td>
                <td data-label="Level" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="level"><%= b.level || '-' %></td>
                <td data-label="Language" class="<%= isAdmin ? 'edit-cell' : '' %>" data-field="language"><%= b.language || '-' %></td>
                <% if (isAdmin) { %>
                  <td data-label="Actions" class="action-cell" style="white-space: nowrap;">
                    <button class="btn-table-action btn-table-edit" onclick="editMasterRow(<%= b.id %>)">✏️ Edit</button>
                    <button class="btn-table-action btn-table-delete" onclick="deleteMasterRow(<%= b.id %>)">❌ Del</button>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="<%= isAdmin ? 11 : 10 %>" style="text-align:center;">No master bhajans found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

<%
    // Extract single unique deities (split by comma for multi-deity bhajans)
    const deityMap = new Map();
    bhajans.forEach(b => {
      if (!b.deity) return;
      const parts = b.deity.split(',').map(s => s.trim()).filter(Boolean);
      parts.forEach(d => {
        let name = d;
        let key = d.toLowerCase();
        if (key === 'vittala' || key === 'vithhala' || key === 'vithala' || key === 'vitthala') {
          name = 'Vitthala';
          key = 'vitthala';
        }
        if (key === 'anjaneya' || key === 'aanjaneya' || key === 'hanuman' || key === 'maruti' || key === 'maruthi') {
          name = 'Hanuman';
          key = 'hanuman';
        }
        if (!deityMap.has(key)) {
          deityMap.set(key, { name: name, count: 0 });
        }
        deityMap.get(key).count++;
      });
    });
    const uniqueDeities = Array.from(deityMap.values()).sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));

    const uniqueTempos = [...new Set(bhajans.map(b => (b.tempo || '').trim()).filter(Boolean))].sort((a,b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

    // Extract single unique ragas (split by comma for multi-raga bhajans, keep Carnatic/Hindustani slash pairs)
    const ragaMap = new Map();
    bhajans.forEach(b => {
      if (!b.raga) return;
      const cleanRaga = b.raga.replace(/~/g, '').trim();
      const parts = cleanRaga.split(',').map(s => s.trim()).filter(Boolean);
      parts.forEach(r => {
        const key = r.toLowerCase();
        if (!ragaMap.has(key)) {
          ragaMap.set(key, { name: r, count: 0 });
        }
        ragaMap.get(key).count++;
      });
    });
    const uniqueRagas = Array.from(ragaMap.values()).sort((a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }));

    function getWesternScale(indianScale) {
      if (!indianScale || indianScale === '-' || indianScale === 'Not specified') return '-';
      const match = indianScale.toString().trim().match(/^([\d\.]+)\s*([PMpm])?.*$/);
      if (!match) return '-';
      const numMap = {'1':0, '1.5':1, '2':2, '2.5':3, '3':4, '4':5, '4.5':6, '5':7, '5.5':8, '6':9, '6.5':10, '7':11};
      if (numMap[match[1]] === undefined) return '-';
      let index = numMap[match[1]];
      if ((match[2] || '').toUpperCase() === 'M') index = (index + 5) % 12;
      return ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"][index];
    }

    function getDeityIcon(deity) {
      if (!deity) return '🕉️';
      const d = deity.toLowerCase();
      if (d.includes('ganesh')) return '🐘';
      if (d.includes('guru')) return '🙏';
      if (d.includes('shiva')) return '🔱';
      if (d.includes('devi') || d.includes('amman') || d.includes('durga') || d.includes('saraswati') || d.includes('lakshmi')) return '🌸';
      if (d.includes('ram')) return '🏹';
      if (d.includes('krishna')) return '🪈';
      if (d.includes('sai') || d.includes('baba')) return '🕉️';
      if (d.includes('subrahmanya') || d.includes('muruga') || d.includes('kartikeya')) return '🪶';
      if (d.includes('hanuman') || d.includes('anjaneya') || d.includes('maruti')) return '🐒';
      if (d.includes('sarva') || d.includes('all')) return '🪔';
      return '✨';
    }
  %>

  <div class="master-bank-page">
    <div class="container container-xl">

      <!-- Unified Master Bhajan Bank Hero, Search & Filter Card -->
      <section class="bank-unified-card" aria-label="Master Bhajan Bank and Search Filters">
        <!-- Top Hero Section within Unified Card -->
        <div class="bank-card-hero">
          <div class="bank-hero-header-row">
            <div class="bank-card-badge-row">
              <span class="bank-hero-icon" aria-hidden="true">📖</span>
              <span class="bank-hero-count-badge" id="heroCountBadge"><%= bhajans.length %> Active Bhajans</span>
              <span class="bank-hero-subtag">Official Mandir Catalog</span>
            </div>
            <% if (isAdmin) { %>
              <div class="bank-top-actions" aria-label="Admin catalog tools">
                <a href="/admin/archived-master-bhajans" class="bank-btn-action secondary-cta" title="View deactivated master bhajans">
                  <span>📦</span> Archived Masters
                </a>
                <a href="/admin/export-master" class="bank-btn-action secondary-cta" title="Download Master Catalog JSON">
                  <span>⬇️</span> Download JSON
                </a>
              </div>
            <% } %>
          </div>
          <h1 class="bank-card-title">Master Bhajan Bank</h1>
          <p class="bank-card-subtitle">
            Search Prashanthi Mandir bhajans, explore verified lyrics, and learn authentic scales, tempos, and ragas. Click any bhajan to view its full lyrics and accompaniment details.
          </p>
        </div>

        <div class="bank-card-divider" aria-hidden="true"></div>

        <!-- Integrated Search Bar Row -->
        <div class="bank-search-row">
          <div class="bank-search-wrap">
            <span class="search-glass-icon" aria-hidden="true">🔍</span>
            <input
              type="search"
              id="filterBankTitle"
              class="bank-search-input"
              placeholder="Search 1,024 bhajans by title, raag, deity, tempo, or pitch..."
              autocomplete="off"
              enterkeyhint="search"
              oninput="handleBankSearchInput(this)"
            />
            <button type="button" id="clearBankSearchBtn" class="clear-search-btn" style="display:none;" onclick="clearBankSearch()" aria-label="Clear search">✕</button>
          </div>
        </div>

        <!-- App-First Swipeable Deity Filter Chips -->
        <div class="bank-deity-chips-scroll" id="bankDeityChipsScroll" role="tablist" aria-label="Filter by Deity">
          <button type="button" class="deity-chip active-chip" data-deity="" onclick="selectDeityChip(this, '')">
            <span>✨ All</span> <span class="chip-count"><%= bhajans.length %></span>
          </button>
          <% uniqueDeities.forEach(d => { %>
            <button type="button" class="deity-chip" data-deity="<%= d.name.toLowerCase() %>" onclick="selectDeityChip(this, '<%= d.name.toLowerCase() %>')">
              <span><%= getDeityIcon(d.name) %> <%= d.name %></span> <span class="chip-count"><%= d.count %></span>
            </button>
          <% }) %>
        </div>

        <!-- Integrated Filter Controls & Result Count Row -->
        <div class="bank-filter-controls-row">
          <div class="bank-dropdowns-strip">
            <!-- Deity Dropdown -->
            <div class="filter-field-group">
              <label for="filterBankDeity" class="filter-field-label">🕉️ Deity</label>
              <select id="filterBankDeity" class="filter-select-control" onchange="filterMasterBank()">
                <option value="">All Deities (<%= bhajans.length %>)</option>
                <% uniqueDeities.forEach(d => { %>
                  <option value="<%= d.name.toLowerCase() %>"><%= d.name %> (<%= d.count %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- Tempo Dropdown -->
            <div class="filter-field-group">
              <label for="filterBankTempo" class="filter-field-label">⏱️ Tempo</label>
              <select id="filterBankTempo" class="filter-select-control" onchange="filterMasterBank()">
                <option value="">All Tempos</option>
                <% uniqueTempos.forEach(t => { %>
                  <option value="<%= t.toLowerCase() %>"><%= t %></option>
                <% }) %>
              </select>
            </div>

            <!-- Raga Dropdown (Clean Ragas Only with Counts) -->
            <div class="filter-field-group">
              <label for="filterBankRaga" class="filter-field-label">🎼 Raag</label>
              <select id="filterBankRaga" class="filter-select-control" onchange="filterMasterBank()">
                <option value="">All Ragas (<%= uniqueRagas.length %>)</option>
                <% uniqueRagas.forEach(r => { %>
                  <option value="<%= r.name.toLowerCase() %>"><%= r.name %> (<%= r.count %>)</option>
                <% }) %>
              </select>
            </div>

            <!-- Reset Button -->
            <div class="filter-field-group reset-field-group">
              <label class="filter-field-label desktop-only-label">&nbsp;</label>
              <button type="button" class="filter-reset-action-btn" onclick="resetAllBankFilters()" title="Reset all search filters">
                <span class="reset-icon">↺</span> Reset Filters
              </button>
            </div>
          </div>

          <!-- Aligned Result Count Indicator -->
          <div class="bank-count-pill" id="bankCountPill">
            Showing <strong id="renderedCountDisplay"><%= Math.min(60, bhajans.length) %></strong> of <strong id="totalMatchingDisplay"><%= bhajans.length %></strong> bhajans
          </div>
        </div>
      </section>

      <!-- Desktop & Tablet Catalog Table with Strict Column Alignment -->
      <div class="table-container bank-table-container">
        <table id="masterBankTable" class="master-catalog-table">
          <thead>
            <tr>
              <th class="col-title" onclick="sortTable(0, 'masterBankTable')" style="cursor:pointer;" title="Sort by Title">Title ↕</th>
              <th class="col-deity" onclick="sortTable(1, 'masterBankTable')" style="cursor:pointer;" title="Sort by Deity">Deity ↕</th>
              <th class="col-tempo" onclick="sortTable(2, 'masterBankTable')" style="cursor:pointer;" title="Sort by Tempo">Tempo ↕</th>
              <th class="col-raga" onclick="sortTable(3, 'masterBankTable')" style="cursor:pointer;" title="Sort by Raga">Raag ↕</th>
              <th class="col-shruti-m" onclick="sortTable(4, 'masterBankTable')" style="cursor:pointer;" title="Sort by Scale Male">Scale (M) ↕</th>
              <th class="col-west-m" onclick="sortTable(5, 'masterBankTable')" style="cursor:pointer;" title="Sort by West M">Key (M) ↕</th>
              <th class="col-shruti-f" onclick="sortTable(6, 'masterBankTable')" style="cursor:pointer;" title="Sort by Scale Female">Scale (F) ↕</th>
              <th class="col-west-f" onclick="sortTable(7, 'masterBankTable')" style="cursor:pointer;" title="Sort by West F">Key (F) ↕</th>
              <th class="col-level" onclick="sortTable(8, 'masterBankTable')" style="cursor:pointer;" title="Sort by Level">Level ↕</th>
              <th class="col-actions"><%= isAdmin ? 'Actions' : 'Lyrics' %></th>
            </tr>
          </thead>
          <tbody>
            <% const initialBhajans = bhajans.slice(0, 60); %>
            <% if (initialBhajans.length > 0) { %>
              <% initialBhajans.forEach(b => { %>
                <tr id="row-<%= b.id %>" data-deity="<%= (b.deity || '').toLowerCase() %>">
                  <td data-label="Title" class="col-title <%= isAdmin ? 'edit-cell' : '' %>" data-field="title">
                    <a href="/bhajan/<%= b.id %>" class="bank-title-link" title="Open lyrics and singing details">
                      <%= b.title %>
                    </a>
                  </td>
                  <td data-label="Deity" class="col-deity <%= isAdmin ? 'edit-cell' : '' %>" data-field="deity">
                    <span class="deity-pill"><%= b.deity || '-' %></span>
                  </td>
                  <td data-label="Tempo" class="col-tempo <%= isAdmin ? 'edit-cell' : '' %>" data-field="tempo">
                    <span class="tempo-cell"><%= b.tempo || '-' %></span>
                  </td>
                  <td data-label="Raag" class="col-raga <%= isAdmin ? 'edit-cell' : '' %>" data-field="raga">
                    <span class="raga-cell"><%= b.raga || '-' %></span>
                  </td>
                  <td data-label="Scale (M)" class="col-shruti-m <%= isAdmin ? 'edit-cell' : '' %>" data-field="shruti">
                    <span class="scale-pill"><%= b.shruti || '-' %></span>
                  </td>
                  <td data-label="Key (M)" id="west-m-<%= b.id %>" class="col-west-m west-scale-cell">
                    <%= getWesternScale(b.shruti) %>
                  </td>
                  <td data-label="Scale (F)" class="col-shruti-f <%= isAdmin ? 'edit-cell' : '' %>" data-field="shruti_female">
                    <span class="scale-pill"><%= b.shruti_female || '-' %></span>
                  </td>
                  <td data-label="Key (F)" id="west-f-<%= b.id %>" class="col-west-f west-scale-cell">
                    <%= getWesternScale(b.shruti_female) %>
                  </td>
                  <td data-label="Level" class="col-level <%= isAdmin ? 'edit-cell' : '' %>" data-field="level"><%= b.level || '-' %></td>
                  <td data-label="Actions" class="col-actions action-cell">
                    <a href="/bhajan/<%= b.id %>" class="btn-table-action btn-table-view" title="View lyrics & accompaniment notes">📖 Lyrics</a>
                    <% if (b.sheet_filename) { %>
                      <a href="/sheets/<%= encodeURIComponent(b.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="btn-table-action btn-table-sheet" title="Open official music sheet (PDF)">📄 Sheet</a>
                    <% } %>
                    <% if (isAdmin) { %>
                      <button class="btn-table-action btn-table-edit" onclick="editMasterRow(<%= b.id %>)">✏️ Edit</button>
                      <button class="btn-table-action btn-table-delete" onclick="deleteMasterRow(<%= b.id %>)">❌ Del</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="<%= isAdmin ? 10 : 10 %>" class="table-empty-cell">No master bhajans found.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Devotional Cards View (< 768px) -->
      <div id="masterBankMobileCards" class="bank-mobile-cards-grid" aria-label="Mobile Bhajan Cards">
        <% if (initialBhajans.length > 0) { %>
          <% initialBhajans.forEach(b => { %>
            <div class="bhajan-mobile-card" id="card-<%= b.id %>" data-id="<%= b.id %>" data-deity="<%= (b.deity || '').toLowerCase() %>" onclick="window.openQuickLyrics(<%= b.id %>)">
              <div class="card-top-row">
                <div class="card-pills-row">
                  <% if (b.deity) { %><span class="deity-pill"><%= getDeityIcon(b.deity) %> <%= b.deity %></span><% } %>
                  <% if (b.tempo) { %><span class="meta-tag tempo-tag">⏱️ <%= b.tempo %></span><% } %>
                </div>
                <div class="card-top-right-actions">
                  <button type="button" class="btn-card-bookmark" data-id="<%= b.id %>" onclick="event.stopPropagation(); window.toggleSongbookBookmark(<%= b.id %>, this)" title="Add to My Songbook" aria-label="Bookmark">
                    <span class="bookmark-star">☆</span>
                  </button>
                  <% if (isAdmin) { %>
                    <div class="card-admin-actions" onclick="event.stopPropagation();">
                      <button class="btn-table-action btn-table-edit" onclick="editMasterRow(<%= b.id %>)">✏️ Edit</button>
                      <button class="btn-table-action btn-table-delete" onclick="deleteMasterRow(<%= b.id %>)">❌</button>
                    </div>
                  <% } %>
                </div>
              </div>
              <h3 class="card-title">
                <a href="/bhajan/<%= b.id %>" onclick="event.stopPropagation();"><%= b.title %></a>
              </h3>
              <div class="card-scales-grid">
                <div class="scale-item">
                  <span class="scale-lbl">👤 Male:</span>
                  <span class="scale-val"><%= b.shruti || '-' %> <%= getWesternScale(b.shruti) !== '-' ? '(' + getWesternScale(b.shruti) + ')' : '' %></span>
                </div>
                <div class="scale-item">
                  <span class="scale-lbl">👩 Female:</span>
                  <span class="scale-val"><%= b.shruti_female || '-' %> <%= getWesternScale(b.shruti_female) !== '-' ? '(' + getWesternScale(b.shruti_female) + ')' : '' %></span>
                </div>
              </div>
              <div class="card-footer-row">
                <div class="card-meta-tags">
                  <% if (b.raga) { %><span class="meta-tag raga-tag">🎼 <%= b.raga %></span><% } %>
                  <% if (b.language) { %><span class="meta-tag lang-tag">🗣️ <%= b.language %></span><% } %>
                </div>
                <div class="card-footer-actions">
                  <% if (b.sheet_filename) { %>
                    <a href="/sheets/<%= encodeURIComponent(b.sheet_filename) %>" target="_blank" rel="noopener noreferrer" class="card-view-sheet-btn" title="Open music sheet (PDF)" onclick="event.stopPropagation();">📄 Sheet</a>
                  <% } %>
                  <button type="button" class="card-quick-lyrics-btn" onclick="event.stopPropagation(); window.openQuickLyrics(<%= b.id %>);">
                    📖 Lyrics
                  </button>
                  <a href="/bhajan/<%= b.id %>" class="card-view-lyrics-btn" onclick="event.stopPropagation();" title="Full devotion details">↗</a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <!-- Load More Button -->
      <% if (bhajans.length > 60) { %>
        <div id="masterBankLoadMore" class="bank-load-more-wrap">
          <button type="button" id="bankLoadMoreBtn" class="bank-load-more-btn">
            📜 Load More Bhajans (<span id="bankRemainingCount"><%= bhajans.length - 60 %></span> remaining)
          </button>
        </div>
      <% } %>

    </div>
  </div>

  <!-- App-First Quick Lyrics Bottom Sheet Modal -->
  <div id="quickLyricsModal" class="modal" role="dialog" aria-modal="true" aria-labelledby="quickLyricsTitle">
    <div class="modal-content quick-lyrics-sheet">
      <div class="sheet-drag-handle"></div>
      
      <div class="modal-header quick-lyrics-header">
        <div class="quick-lyrics-title-wrap">
          <div class="quick-lyrics-badge-strip">
            <span id="quickDeityBadge" class="hero-pill deity-pill">🕉️ Sai</span>
            <span id="quickTempoBadge" class="hero-pill tempo-pill">⏱️ Fast</span>
            <span id="quickRagaBadge" class="hero-pill raga-pill" style="display:none;">🎼 Raag</span>
          </div>
          <h2 id="quickLyricsTitle" class="quick-lyrics-title">Bhajan Title</h2>
        </div>
        <button type="button" class="close-btn" onclick="closeQuickLyrics()" aria-label="Close">&times;</button>
      </div>

      <!-- Accompaniment Scales -->
      <div class="quick-scales-bar">
        <div class="quick-scale-box">
          <span class="scale-lbl">👤 Male Pitch:</span>
          <strong id="quickScaleMale" class="scale-val">-</strong>
        </div>
        <div class="quick-scale-box">
          <span class="scale-lbl">👩 Female Pitch:</span>
          <strong id="quickScaleFemale" class="scale-val">-</strong>
        </div>
      </div>

      <!-- Sacred Lyrics Reader Area -->
      <div class="quick-lyrics-reader-box">
        <div class="quick-lyrics-toolbar">
          <span class="quick-reader-heading">📜 Sacred Lyrics</span>
          <div class="quick-reader-controls">
            <button type="button" class="font-btn" onclick="adjustQuickFontSize(-2)" title="Decrease font">A−</button>
            <span id="quickFontSizeVal" class="quick-font-val">19px</span>
            <button type="button" class="font-btn" onclick="adjustQuickFontSize(2)" title="Increase font">A+</button>
            <button type="button" class="font-btn font-reset-btn" onclick="adjustQuickFontSize(0)" title="Reset font">↺</button>
          </div>
        </div>
        <div id="quickLyricsText" class="quick-lyrics-content">
          <!-- Populated dynamically -->
        </div>
      </div>

      <!-- Modal Bottom Actions Row -->
      <div class="modal-actions-row quick-modal-actions">
        <button type="button" id="quickCopyBtn" class="button secondary btn-modal-edit" onclick="copyQuickLyrics()">
          📋 Copy
        </button>
        <button type="button" id="quickBookmarkBtn" class="button secondary btn-modal-edit" onclick="toggleQuickBookmark()">
          ⭐ Songbook
        </button>
        <a id="quickScheduleBtn" href="/submit-form" class="button button-confirm btn-modal-confirm" style="text-decoration:none;">
          🎤 Schedule
        </a>
        <a id="quickFullPageBtn" href="#" class="button secondary btn-modal-edit" style="text-decoration:none;">
          📖 Full Page ↗
        </a>
      </div>
    </div>
  </div>

  <!-- Toast Notification for Quick Actions -->
  <div id="bankToast" class="bank-toast" style="display:none;" role="status" aria-live="polite"></div>

  <!-- Raw Master Bhajans Data Cache for Instant Zero-Latency Filtering -->
  <script id="allMasterBhajansData" type="application/json">
    <%- JSON.stringify(bhajans.map(b => ({
      id: b.id,
      title: b.title,
      deity: b.deity || '',
      tempo: b.tempo || '',
      raga: b.raga || '',
      shruti: b.shruti || '',
      shruti_female: b.shruti_female || '',
      wm: getWesternScale(b.shruti),
      wf: getWesternScale(b.shruti_female),
      level: b.level || '',
      language: b.language || '',
      sheet_filename: b.sheet_filename || '',
      lyrics: b.lyrics || ''
    }))) %>
  </script>

  <script>
  (function() {
    var dataElem = document.getElementById('allMasterBhajansData');
    if (!dataElem) return;
    var allData = [];
    try { allData = JSON.parse(dataElem.textContent); } catch (e) { return; }
    window.ALL_MASTER_BHAJANS = allData;
    window.IS_ADMIN_MASTER_BANK = <%= isAdmin ? 'true' : 'false' %>;

    var tbody = document.querySelector('#masterBankTable tbody');
    var mobileCardsContainer = document.getElementById('masterBankMobileCards');
    var loadMoreBtn = document.getElementById('bankLoadMoreBtn');
    var loadMoreDiv = document.getElementById('masterBankLoadMore');
    var remCount = document.getElementById('bankRemainingCount');
    var renderedCountDisplay = document.getElementById('renderedCountDisplay');
    var totalMatchingDisplay = document.getElementById('totalMatchingDisplay');
    var clearSearchBtn = document.getElementById('clearBankSearchBtn');

    var currentMatches = allData;
    var renderedCount = Math.min(60, allData.length);
    var BATCH_SIZE = 60;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function createRowHtml(b) {
      var isAdmin = window.IS_ADMIN_MASTER_BANK;
      var editClass = isAdmin ? ' edit-cell' : '';
      var deityPill = b.deity ? '<span class="deity-pill">' + escapeHtml(b.deity) + '</span>' : '-';
      var sheetBtn = b.sheet_filename ? '<a href="/sheets/' + encodeURIComponent(b.sheet_filename) + '" target="_blank" rel="noopener noreferrer" class="btn-table-action btn-table-sheet" title="Open official music sheet (PDF)">📄 Sheet</a> ' : '';
      var actionsHtml = '<td data-label="Actions" class="col-actions action-cell">' +
        '<a href="/bhajan/' + b.id + '" class="btn-table-action btn-table-view" title="View lyrics & accompaniment notes">📖 Lyrics</a> ' +
        sheetBtn;
      if (isAdmin) {
        actionsHtml += '<button class="btn-table-action btn-table-edit" onclick="editMasterRow(' + b.id + ')">✏️ Edit</button> ' +
          '<button class="btn-table-action btn-table-delete" onclick="deleteMasterRow(' + b.id + ')">❌ Del</button>';
      }
      actionsHtml += '</td>';

      return '<tr id="row-' + b.id + '" data-deity="' + escapeHtml((b.deity || '').toLowerCase()) + '">' +
        '<td data-label="Title" class="col-title' + editClass + '" data-field="title"><a href="/bhajan/' + b.id + '" class="bank-title-link" title="Open lyrics and singing details">' + escapeHtml(b.title) + '</a></td>' +
        '<td data-label="Deity" class="col-deity' + editClass + '" data-field="deity">' + deityPill + '</td>' +
        '<td data-label="Tempo" class="col-tempo' + editClass + '" data-field="tempo"><span class="tempo-cell">' + escapeHtml(b.tempo || '-') + '</span></td>' +
        '<td data-label="Raag" class="col-raga' + editClass + '" data-field="raga"><span class="raga-cell">' + escapeHtml(b.raga || '-') + '</span></td>' +
        '<td data-label="Scale (M)" class="col-shruti-m' + editClass + '" data-field="shruti"><span class="scale-pill">' + escapeHtml(b.shruti || '-') + '</span></td>' +
        '<td data-label="Key (M)" id="west-m-' + b.id + '" class="col-west-m west-scale-cell">' + escapeHtml(b.wm || '-') + '</td>' +
        '<td data-label="Scale (F)" class="col-shruti-f' + editClass + '" data-field="shruti_female"><span class="scale-pill">' + escapeHtml(b.shruti_female || '-') + '</span></td>' +
        '<td data-label="Key (F)" id="west-f-' + b.id + '" class="col-west-f west-scale-cell">' + escapeHtml(b.wf || '-') + '</td>' +
        '<td data-label="Level" class="col-level' + editClass + '" data-field="level">' + escapeHtml(b.level || '-') + '</td>' +
        actionsHtml +
        '</tr>';
    }

    function getDeityIconClient(deity) {
      if (!deity) return '🕉️';
      var d = deity.toLowerCase();
      if (d.includes('ganesh')) return '🐘';
      if (d.includes('guru')) return '🙏';
      if (d.includes('shiva')) return '🔱';
      if (d.includes('devi') || d.includes('amman') || d.includes('durga') || d.includes('saraswati') || d.includes('lakshmi')) return '🌸';
      if (d.includes('ram')) return '🏹';
      if (d.includes('krishna')) return '🪈';
      if (d.includes('sai') || d.includes('baba')) return '🕉️';
      if (d.includes('subrahmanya') || d.includes('muruga') || d.includes('kartikeya')) return '🪶';
      if (d.includes('sarva') || d.includes('all')) return '🪔';
      return '✨';
    }

    function createCardHtml(b) {
      var isAdmin = window.IS_ADMIN_MASTER_BANK;
      var isBookmarked = window.BOOKMARKED_BHAJAN_IDS && window.BOOKMARKED_BHAJAN_IDS.has(Number(b.id));
      var deityPill = b.deity ? '<span class="deity-pill">' + getDeityIconClient(b.deity) + ' ' + escapeHtml(b.deity) + '</span>' : '';
      var tempoPill = b.tempo ? '<span class="meta-tag tempo-tag">⏱️ ' + escapeHtml(b.tempo) + '</span>' : '';
      var ragaTag = b.raga ? '<span class="meta-tag raga-tag">🎼 ' + escapeHtml(b.raga) + '</span>' : '';
      var langTag = b.language ? '<span class="meta-tag lang-tag">🗣️ ' + escapeHtml(b.language) + '</span>' : '';
      var sheetBtn = b.sheet_filename ? '<a href="/sheets/' + encodeURIComponent(b.sheet_filename) + '" target="_blank" rel="noopener noreferrer" class="card-view-sheet-btn" title="Open music sheet (PDF)" onclick="event.stopPropagation();">📄 Sheet</a>' : '';

      var scaleM = (b.shruti || '-') + (b.wm && b.wm !== '-' ? ' (' + b.wm + ')' : '');
      var scaleF = (b.shruti_female || '-') + (b.wf && b.wf !== '-' ? ' (' + b.wf + ')' : '');

      var bookmarkBtn = '<button type="button" class="btn-card-bookmark ' + (isBookmarked ? 'active' : '') + '" data-id="' + b.id + '" onclick="event.stopPropagation(); window.toggleSongbookBookmark(' + b.id + ', this);" title="' + (isBookmarked ? 'Remove from Songbook' : 'Add to My Songbook') + '" aria-label="Bookmark">' +
        '<span class="bookmark-star">' + (isBookmarked ? '★' : '☆') + '</span>' +
        '</button>';

      var adminActions = '';
      if (isAdmin) {
        adminActions = '<div class="card-admin-actions" onclick="event.stopPropagation();">' +
          '<button class="btn-table-action btn-table-edit" onclick="editMasterRow(' + b.id + ')">✏️ Edit</button> ' +
          '<button class="btn-table-action btn-table-delete" onclick="deleteMasterRow(' + b.id + ')">❌</button>' +
          '</div>';
      }

      return '<div class="bhajan-mobile-card" id="card-' + b.id + '" data-id="' + b.id + '" data-deity="' + escapeHtml((b.deity || '').toLowerCase()) + '" onclick="window.openQuickLyrics(' + b.id + ');">' +
        '<div class="card-top-row">' +
          '<div class="card-pills-row">' + deityPill + tempoPill + '</div>' +
          '<div class="card-top-right-actions">' + bookmarkBtn + adminActions + '</div>' +
        '</div>' +
        '<h3 class="card-title"><a href="/bhajan/' + b.id + '" onclick="event.stopPropagation();">' + escapeHtml(b.title) + '</a></h3>' +
        '<div class="card-scales-grid">' +
          '<div class="scale-item"><span class="scale-lbl">👤 Male:</span> <span class="scale-val">' + escapeHtml(scaleM) + '</span></div>' +
          '<div class="scale-item"><span class="scale-lbl">👩 Female:</span> <span class="scale-val">' + escapeHtml(scaleF) + '</span></div>' +
        '</div>' +
        '<div class="card-footer-row">' +
          '<div class="card-meta-tags">' + ragaTag + langTag + '</div>' +
          '<div class="card-footer-actions">' +
            sheetBtn +
            '<button type="button" class="card-quick-lyrics-btn" onclick="event.stopPropagation(); window.openQuickLyrics(' + b.id + ');">' +
              '📖 Lyrics' +
            '</button>' +
            '<a href="/bhajan/' + b.id + '" class="card-view-lyrics-btn" onclick="event.stopPropagation();" title="Full devotion details">↗</a>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function updateLoadMoreUI() {
      if (renderedCountDisplay) renderedCountDisplay.textContent = Math.min(renderedCount, currentMatches.length);
      if (totalMatchingDisplay) totalMatchingDisplay.textContent = currentMatches.length;

      if (!loadMoreDiv) return;
      var remaining = currentMatches.length - renderedCount;
      if (remaining > 0) {
        loadMoreDiv.style.display = '';
        if (remCount) remCount.textContent = remaining;
      } else {
        loadMoreDiv.style.display = 'none';
      }
    }

    window.renderMoreMasterBank = function() {
      var nextBatch = currentMatches.slice(renderedCount, renderedCount + BATCH_SIZE);
      if (nextBatch.length === 0) return;
      if (tbody) {
        var tableHtml = nextBatch.map(createRowHtml).join('');
        tbody.insertAdjacentHTML('beforeend', tableHtml);
      }
      if (mobileCardsContainer) {
        var cardsHtml = nextBatch.map(createCardHtml).join('');
        mobileCardsContainer.insertAdjacentHTML('beforeend', cardsHtml);
      }
      renderedCount += nextBatch.length;
      updateLoadMoreUI();
    };

    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', window.renderMoreMasterBank);
    }

    function getWords(str) {
      return (str || '')
        .toLowerCase()
        .replace(/[''`".,;:!?()\[\]{}\/\\~-]/g, ' ')
        .split(/\s+/)
        .filter(Boolean);
    }

    function normalizeSearch(str) {
      return (str || '')
        .toLowerCase()
        .replace(/[''`".,;:!?()\[\]{}\/\\~-]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    // Pre-index catalog for instant sub-millisecond, highly accurate search
    var searchCatalog = allData.map(function(b) {
      var titleWords = getWords(b.title);
      var deityWords = getWords(b.deity);
      var ragaWords = getWords(b.raga);
      var tempoWords = getWords(b.tempo);
      var langWords = getWords(b.language);
      var allWords = titleWords.concat(deityWords, ragaWords, tempoWords, langWords);

      // Clean individual deities list for multi-deity bhajans
      var deityList = (b.deity || '')
        .toLowerCase()
        .split(',')
        .map(function(s) {
          var trimmed = s.trim();
          if (trimmed === 'vittala' || trimmed === 'vithhala' || trimmed === 'vithala') return 'vitthala';
          return trimmed;
        })
        .filter(Boolean);

      // Clean individual ragas list for multi-raga bhajans
      var ragaList = (b.raga || '')
        .replace(/~/g, '')
        .toLowerCase()
        .split(',')
        .map(function(s) { return s.trim(); })
        .filter(Boolean);

      return {
        item: b,
        titleWords: titleWords,
        titleNorm: titleWords.join(' '),
        deityWords: deityWords,
        ragaWords: ragaWords,
        tempoWords: tempoWords,
        allWords: allWords,
        deityLower: (b.deity || '').toLowerCase().trim(),
        deityList: deityList,
        tempoLower: (b.tempo || '').toLowerCase().trim(),
        ragaList: ragaList
      };
    });

    window.handleBankSearchInput = function(input) {
      if (clearSearchBtn) {
        clearSearchBtn.style.display = input.value.trim() ? 'block' : 'none';
      }
      window.filterMasterBank();
    };

    window.clearBankSearch = function() {
      var input = document.getElementById('filterBankTitle');
      if (input) {
        input.value = '';
        if (clearSearchBtn) clearSearchBtn.style.display = 'none';
        input.focus();
      }
      window.filterMasterBank();
    };

    window.selectDeityChip = function(btn, deityVal) {
      document.querySelectorAll('.deity-chip').forEach(function(c) { c.classList.remove('active-chip'); });
      if (btn) btn.classList.add('active-chip');
      var deitySelect = document.getElementById('filterBankDeity');
      if (deitySelect) {
        deitySelect.value = deityVal;
      }
      window.filterMasterBank();
      if (btn && btn.scrollIntoView) {
        btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    };

    window.resetAllBankFilters = function() {
      var titleIn = document.getElementById('filterBankTitle');
      var deityIn = document.getElementById('filterBankDeity');
      var tempoIn = document.getElementById('filterBankTempo');
      var ragaIn = document.getElementById('filterBankRaga');

      if (titleIn) titleIn.value = '';
      if (deityIn) deityIn.value = '';
      if (tempoIn) tempoIn.value = '';
      if (ragaIn) ragaIn.value = '';
      if (clearSearchBtn) clearSearchBtn.style.display = 'none';

      document.querySelectorAll('.deity-chip').forEach(function(c) { c.classList.remove('active-chip'); });
      var allChip = document.querySelector('.deity-chip[data-deity=""]');
      if (allChip) allChip.classList.add('active-chip');

      window.filterMasterBank();
    };

    window.filterMasterBank = function() {
      var rawSearch = (document.getElementById('filterBankTitle') ? document.getElementById('filterBankTitle').value : '').trim();
      var normQuery = normalizeSearch(rawSearch);
      var queryTokens = normQuery.split(' ').filter(Boolean);
      var uniqueTokens = [];
      for (var k = 0; k < queryTokens.length; k++) {
        if (uniqueTokens.indexOf(queryTokens[k]) === -1) uniqueTokens.push(queryTokens[k]);
      }

      var deityFilter = (document.getElementById('filterBankDeity') ? document.getElementById('filterBankDeity').value : '').trim().toLowerCase();
      document.querySelectorAll('.deity-chip').forEach(function(c) {
        c.classList.toggle('active-chip', (c.getAttribute('data-deity') || '') === deityFilter);
      });
      var tempoFilter = (document.getElementById('filterBankTempo') ? document.getElementById('filterBankTempo').value : '').trim().toLowerCase();
      var ragaFilter  = (document.getElementById('filterBankRaga') ? document.getElementById('filterBankRaga').value : '').trim().toLowerCase();

      var scoredMatches = [];

      for (var i = 0; i < searchCatalog.length; i++) {
        var entry = searchCatalog[i];

        // 1. Dropdown Filters
        if (deityFilter && entry.deityList.indexOf(deityFilter) === -1) continue;
        if (tempoFilter && entry.tempoLower !== tempoFilter) continue;
        if (ragaFilter && entry.ragaList.indexOf(ragaFilter) === -1) continue;

        // 2. Query Search with Word-Boundary Accuracy & Relevance Scoring
        var score = 1;
        if (uniqueTokens.length > 0) {
          // Every search token must match either a word prefix or title substring
          var allTokensMatch = true;
          for (var t = 0; t < uniqueTokens.length; t++) {
            var tok = uniqueTokens[t];
            var matchPrefix = false;
            for (var w = 0; w < entry.allWords.length; w++) {
              if (entry.allWords[w].indexOf(tok) === 0) {
                matchPrefix = true;
                break;
              }
            }
            var matchInTitle = entry.titleNorm.indexOf(tok) !== -1;
            if (!matchPrefix && !matchInTitle) {
              allTokensMatch = false;
              break;
            }
          }
          if (!allTokensMatch) continue;

          // Compute Relevance Score
          score = 0;
          if (entry.titleNorm === normQuery) {
            score += 6000;
          } else if (entry.titleNorm.indexOf(normQuery) === 0) {
            score += 4000;
          } else if (entry.titleNorm.indexOf(normQuery) !== -1) {
            score += 2500;
          }

          var titleTokenMatches = 0;
          for (var ut = 0; ut < uniqueTokens.length; ut++) {
            var uTok = uniqueTokens[ut];
            var exactInTitle = false;
            var prefixInTitle = false;
            for (var tw = 0; tw < entry.titleWords.length; tw++) {
              if (entry.titleWords[tw] === uTok) {
                exactInTitle = true;
                break;
              } else if (entry.titleWords[tw].indexOf(uTok) === 0) {
                prefixInTitle = true;
              }
            }
            if (exactInTitle) {
              titleTokenMatches += 2;
              score += 300;
            } else if (prefixInTitle) {
              titleTokenMatches += 1;
              score += 150;
            } else if (entry.titleNorm.indexOf(uTok) !== -1) {
              score += 50;
            }
          }

          // Substantial boost when title contains all searched tokens
          if (titleTokenMatches >= uniqueTokens.length) {
            score += 1200;
          }

          // Metadata matches
          for (var m = 0; m < uniqueTokens.length; m++) {
            var mTok = uniqueTokens[m];
            for (var dw = 0; dw < entry.deityWords.length; dw++) {
              if (entry.deityWords[dw].indexOf(mTok) === 0) { score += 40; break; }
            }
            for (var rw = 0; rw < entry.ragaWords.length; rw++) {
              if (entry.ragaWords[rw].indexOf(mTok) === 0) { score += 30; break; }
            }
            for (var tmpw = 0; tmpw < entry.tempoWords.length; tmpw++) {
              if (entry.tempoWords[tmpw].indexOf(mTok) === 0) { score += 20; break; }
            }
          }
        }

        scoredMatches.push({ item: entry.item, score: score, originalIndex: i });
      }

      // Sort by score descending if query entered, else maintain catalog order
      if (uniqueTokens.length > 0) {
        scoredMatches.sort(function(a, b) {
          if (b.score !== a.score) return b.score - a.score;
          return a.originalIndex - b.originalIndex;
        });
      }

      currentMatches = scoredMatches.map(function(s) { return s.item; });
      renderedCount = Math.min(BATCH_SIZE, currentMatches.length);

      if (tbody) {
        if (currentMatches.length === 0) {
          tbody.innerHTML = '<tr><td colspan="' + (window.IS_ADMIN_MASTER_BANK ? 10 : 10) + '" class="table-empty-cell">🔍 No matching bhajans found. Try adjusting your search query or filters.</td></tr>';
        } else {
          tbody.innerHTML = currentMatches.slice(0, renderedCount).map(createRowHtml).join('');
        }
      }

      if (mobileCardsContainer) {
        if (currentMatches.length === 0) {
          mobileCardsContainer.innerHTML = '<div class="mobile-empty-cards"><span class="empty-icon">🔍</span><p>No matching bhajans found. Try adjusting your search query or filters.</p></div>';
        } else {
          mobileCardsContainer.innerHTML = currentMatches.slice(0, renderedCount).map(createCardHtml).join('');
        }
      }

      updateLoadMoreUI();
    };

    // ---------------------------------------------------------------
    // PHASE 4: QUICK LYRICS BOTTOM SHEET & SONGBOOK BOOKMARKS
    // ---------------------------------------------------------------
    var activeQuickBhajan = null;
    var currentQuickFontSize = 19;

    window.openQuickLyrics = function(id) {
      var b = allData.find(function(x) { return x.id === id || String(x.id) === String(id); });
      if (!b) return;
      activeQuickBhajan = b;

      var modal = document.getElementById('quickLyricsModal');
      var titleElem = document.getElementById('quickLyricsTitle');
      var deityBadge = document.getElementById('quickDeityBadge');
      var tempoBadge = document.getElementById('quickTempoBadge');
      var ragaBadge = document.getElementById('quickRagaBadge');
      var maleElem = document.getElementById('quickScaleMale');
      var femaleElem = document.getElementById('quickScaleFemale');
      var textElem = document.getElementById('quickLyricsText');
      var scheduleBtn = document.getElementById('quickScheduleBtn');
      var fullPageBtn = document.getElementById('quickFullPageBtn');
      var bookmarkBtn = document.getElementById('quickBookmarkBtn');

      if (titleElem) titleElem.textContent = b.title;
      if (deityBadge) {
        deityBadge.innerHTML = getDeityIconClient(b.deity) + ' ' + (b.deity || 'Devotional');
      }
      if (tempoBadge) {
        if (b.tempo) {
          tempoBadge.textContent = '⏱️ ' + b.tempo;
          tempoBadge.style.display = 'inline-block';
        } else {
          tempoBadge.style.display = 'none';
        }
      }
      if (ragaBadge) {
        if (b.raga) {
          ragaBadge.textContent = '🎼 ' + b.raga;
          ragaBadge.style.display = 'inline-block';
        } else {
          ragaBadge.style.display = 'none';
        }
      }

      var scaleM = (b.shruti || '-') + (b.wm && b.wm !== '-' ? ' (' + b.wm + ')' : '');
      var scaleF = (b.shruti_female || '-') + (b.wf && b.wf !== '-' ? ' (' + b.wf + ')' : '');
      if (maleElem) maleElem.textContent = scaleM;
      if (femaleElem) femaleElem.textContent = scaleF;

      if (textElem) {
        if (b.lyrics && b.lyrics.trim().length > 0) {
          var stanzas = b.lyrics.trim().split(/\r?\n\s*\r?\n/);
          textElem.innerHTML = stanzas.map(function(st) {
            return '<div class="quick-lyrics-stanza">' + escapeHtml(st).replace(/\n/g, '<br/>') + '</div>';
          }).join('');
        } else {
          textElem.innerHTML = '<div class="empty-lyrics-prompt">' +
            '<p>🌸 Lyrics are being added to our sacred master bank.</p>' +
            '<a href="/bhajan/' + b.id + '" class="button secondary" style="display:inline-block; font-size:12px; margin-top:8px;">Open Full Page to Contribute</a>' +
            '</div>';
        }
      }

      if (scheduleBtn) {
        scheduleBtn.href = '/submit-form?prefill_title=' + encodeURIComponent(b.title) +
          '&prefill_deity=' + encodeURIComponent(b.deity || '') +
          '&prefill_scale=' + encodeURIComponent(b.shruti || '') +
          '&prefill_speed=' + encodeURIComponent(b.tempo || '') +
          '&master_id=' + b.id;
      }
      if (fullPageBtn) {
        fullPageBtn.href = '/bhajan/' + b.id;
      }

      var isBookmarked = window.BOOKMARKED_BHAJAN_IDS && window.BOOKMARKED_BHAJAN_IDS.has(Number(b.id));
      if (bookmarkBtn) {
        bookmarkBtn.innerHTML = isBookmarked ? '★ In Songbook' : '⭐ Songbook';
        bookmarkBtn.classList.toggle('bookmarked', isBookmarked);
      }

      if (modal) modal.classList.add('show');
    };

    window.closeQuickLyrics = function() {
      var modal = document.getElementById('quickLyricsModal');
      if (modal) modal.classList.remove('show');
    };

    window.copyQuickLyrics = function() {
      if (!activeQuickBhajan) return;
      var text = activeQuickBhajan.title + '\nDeity: ' + (activeQuickBhajan.deity || 'Sai') + '\n\n' + (activeQuickBhajan.lyrics || '');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          var btn = document.getElementById('quickCopyBtn');
          if (btn) {
            var orig = btn.innerHTML;
            btn.innerHTML = '✅ Copied!';
            setTimeout(function() { btn.innerHTML = orig; }, 1800);
          }
          window.showToast('📋 Bhajan lyrics copied to clipboard!');
        });
      }
    };

    window.adjustQuickFontSize = function(delta) {
      if (delta === 0) {
        currentQuickFontSize = 19;
      } else {
        currentQuickFontSize = Math.min(30, Math.max(14, currentQuickFontSize + delta));
      }
      var textElem = document.getElementById('quickLyricsText');
      var valElem = document.getElementById('quickFontSizeVal');
      if (textElem) textElem.style.fontSize = currentQuickFontSize + 'px';
      if (valElem) valElem.textContent = currentQuickFontSize + 'px';
    };

    window.showToast = function(msg) {
      var toast = document.getElementById('bankToast');
      if (!toast) return;
      toast.textContent = msg;
      toast.style.display = 'block';
      toast.classList.add('show');
      setTimeout(function() {
        toast.classList.remove('show');
        setTimeout(function() { toast.style.display = 'none'; }, 250);
      }, 2500);
    };

    // Singer Bookmarking integration
    window.BOOKMARKED_BHAJAN_IDS = new Set();

    function saveLocalBookmarks() {
      try {
        localStorage.setItem('bj_bookmarks', JSON.stringify(Array.from(window.BOOKMARKED_BHAJAN_IDS)));
      } catch (e) {}
    }

    function updateBookmarkStarsOnPage(id, isBookmarked) {
      document.querySelectorAll('.btn-card-bookmark[data-id="' + id + '"]').forEach(function(b) {
        b.classList.toggle('active', isBookmarked);
        var star = b.querySelector('.bookmark-star');
        if (star) star.textContent = isBookmarked ? '★' : '☆';
      });

      if (activeQuickBhajan && String(activeQuickBhajan.id) === String(id)) {
        var quickBmBtn = document.getElementById('quickBookmarkBtn');
        if (quickBmBtn) {
          quickBmBtn.innerHTML = isBookmarked ? '★ In Songbook' : '⭐ Songbook';
          quickBmBtn.classList.toggle('bookmarked', isBookmarked);
        }
      }
    }

    window.toggleSongbookBookmark = async function(id, btnElem) {
      var isNowBookmarked = !window.BOOKMARKED_BHAJAN_IDS.has(Number(id));
      if (isNowBookmarked) {
        window.BOOKMARKED_BHAJAN_IDS.add(Number(id));
        window.showToast('⭐ Saved to your Personal Songbook!');
      } else {
        window.BOOKMARKED_BHAJAN_IDS.delete(Number(id));
        window.showToast('Removed from Personal Songbook');
      }
      saveLocalBookmarks();
      updateBookmarkStarsOnPage(id, isNowBookmarked);

      // Try server sync
      try {
        await fetch('/api/singer/songbook/toggle', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ master_id: id })
        });
      } catch (err) {
        // Fallback already saved locally
      }
    };

    window.toggleQuickBookmark = function() {
      if (!activeQuickBhajan) return;
      window.toggleSongbookBookmark(activeQuickBhajan.id);
    };

    // Load initial bookmarks from localStorage & server
    (async function loadUserBookmarks() {
      try {
        var local = localStorage.getItem('bj_bookmarks');
        if (local) {
          var parsed = JSON.parse(local);
          if (Array.isArray(parsed)) {
            parsed.forEach(function(bid) { window.BOOKMARKED_BHAJAN_IDS.add(Number(bid)); });
          }
        }
      } catch (e) {}

      try {
        var res = await fetch('/api/singer/songbook');
        var data = await res.json();
        if (data && data.bookmarks && Array.isArray(data.bookmarks)) {
          data.bookmarks.forEach(function(bm) {
            window.BOOKMARKED_BHAJAN_IDS.add(Number(bm.master_id));
          });
          saveLocalBookmarks();
        }
      } catch (e) {}

      // Update initial rendered cards
      document.querySelectorAll('.btn-card-bookmark').forEach(function(b) {
        var bid = Number(b.getAttribute('data-id'));
        if (window.BOOKMARKED_BHAJAN_IDS.has(bid)) {
          b.classList.add('active');
          var star = b.querySelector('.bookmark-star');
          if (star) star.textContent = '★';
        }
      });
    })();
  })();
  </script>
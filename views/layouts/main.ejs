<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#fbf8f2">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/images/icons/icon-192x192.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/images/icons/icon-192x192.png">

<title>
    <%= typeof pageTitle !== "undefined"
        ? pageTitle
        : "Bhajan Planner" %>
</title>
    <!-- Global CSS with Cache Busting -->
<link rel="stylesheet" href="/css/style.css?v=2.7">
<link rel="stylesheet" href="/css/pwa.css?v=2.7">
<link rel="stylesheet" href="/css/notifications.css?v=2.7">
<link rel="stylesheet" href="/css/bulletin.css?v=2.7">

<% if (typeof showLoader !== "undefined" && showLoader) { %>
<link rel="stylesheet" href="/css/loading.css?v=2.7">
<% } %>

<% if (typeof isAdminPage !== "undefined" && isAdminPage) { %>
<link rel="stylesheet" href="/css/admin.css?v=2.7">
<% } %>

<!-- Optional page-specific CSS -->
<% if (pageCSS) { %>
<link rel="stylesheet" href="/css/<%= pageCSS %>?v=2.7">
<% } %>

<!-- Critical Anti-FOUC for Floating Theme Toggle & Absolute Print Elimination -->
<style>
@media screen {
  .theme-toggle {
    position: fixed !important;
    bottom: 88px !important;
    right: 24px !important;
    z-index: 9998 !important;
    width: 52px !important;
    height: 52px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }
  @media (max-width: 360px) {
    .theme-toggle {
      width: 46px !important;
      height: 46px !important;
      bottom: 74px !important;
      right: 16px !important;
    }
  }
}
@media print {
  .theme-toggle,
  #themeToggle,
  .notif-bell-btn,
  #notifBellBtn,
  .notif-badge,
  .notif-panel,
  .notif-overlay,
  .notif-prompt-overlay,
  .pwa-install-overlay,
  #pwaInstallOverlay,
  .notification-bell-container {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    position: fixed !important;
    left: -9999px !important;
    top: -9999px !important;
    width: 0 !important;
    height: 0 !important;
    pointer-events: none !important;
  }
}
</style>

<!-- Dark mode: read preference BEFORE page renders to prevent flash -->
<script>
(function(){
  try {
    var t = localStorage.getItem('bp-theme');
    if (t === 'dark') document.documentElement.setAttribute('data-theme','dark');
  } catch(e){}
})();
</script>
</head>

<body class="<%= (typeof isAdminPage !== 'undefined' && isAdminPage && currentAdmin) ? 'admin-page' : '' %>">

    <!-- PWA Install Banner -->
    <div class="pwa-install-overlay" id="pwaInstallOverlay">
      <div class="pwa-install-banner">
        <div class="pwa-banner-header">
          <img src="/images/icons/icon-192x192.png" alt="Bhajan Planner" class="pwa-banner-icon">
          <div class="pwa-banner-info">
            <h3>Install Bhajan Planner</h3>
            <p class="pwa-banner-size">App size <span class="size-dot"></span> <span id="pwaBannerSize">calculating…</span></p>
          </div>
          <button class="pwa-banner-close" id="pwaBannerClose" aria-label="Close">✕</button>
        </div>
        <div class="pwa-banner-divider"></div>
        <div class="pwa-banner-benefits">
          <div class="pwa-benefit"><span>⚡</span> Faster loading</div>
          <div class="pwa-benefit"><span>📱</span> Works like a native app</div>
          <div class="pwa-benefit"><span>🏠</span> Home screen access</div>
        </div>
        <div class="pwa-banner-actions">
          <button class="pwa-btn-install" id="pwaBtnInstall">Install App</button>
          <button class="pwa-btn-dismiss" id="pwaBtnDismiss">Not Now</button>
        </div>
        <div class="pwa-ios-instructions" id="pwaIosInstructions" style="display:none">
          <p>Tap <strong>Share</strong> <span class="pwa-ios-share-icon">⬆</span> then <strong>"Add to Home Screen"</strong></p>
        </div>
      </div>
    </div>

    <% if (typeof showLoader !== "undefined" && showLoader) { %>
    <%- include("../partials/loading") %>
    <% } %>

    <!-- Dark Mode Toggle (floating, above notification bell) -->
    <button
      class="theme-toggle"
      id="themeToggle"
      aria-label="Toggle dark mode"
      aria-pressed="false"
      data-tooltip="Switch to Dark"
    >
      <span class="icon-moon" aria-hidden="true">🌙</span>
      <span class="icon-sun"  aria-hidden="true">☀️</span>
    </button>

    <!-- Notification Center (user-facing) -->
    <%- include("../partials/notification-bell") %>

    <% if (typeof isAdminPage !== "undefined" && isAdminPage && currentAdmin) { %>
      <div class="admin-layout">
        <%- include('../partials/sidebar') %>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
        <main class="main-content">
          <%- include('../partials/topbar') %>
          <div class="page-body"><%- body %></div>
        </main>
      </div>
    <% } else { %>
      <%- body %>
    <% } %>

    <!-- Global JS -->
    <script src="/js/script.js"></script>
    <script src="/js/pwa.js"></script>
    <script src="/js/notifications.js"></script>

    <% if (typeof showLoader !== "undefined" && showLoader) { %>
    <script src="/js/loading.js"></script>
    <% } %>

    <!-- Optional page-specific JS -->
    <% if (typeof pageJS !== "undefined" && pageJS) { %>
        <script src="/js/<%= pageJS %>"></script>
    <% } %>

</body>
</html>


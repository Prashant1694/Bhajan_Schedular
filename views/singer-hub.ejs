<div class="container singer-hub-container" style="max-width: 960px; margin: 30px auto; padding: 24px 20px 32px 20px;">

  <!-- Profile Actions Bar -->
  <div class="singer-hub-top-nav">
    <div class="singer-hub-actions-group">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <button type="button" onclick="openAdminSwitchModal()" class="singer-hub-action-btn btn-switch-singer" data-haptic="light" title="Switch to another singer profile">
          <span class="hub-btn-icon">🔄</span>
          <span class="hub-btn-text">Switch Singer</span>
        </button>
      <% } %>
      <button type="button" onclick="openChangePinModal()" class="singer-hub-action-btn btn-change-pin" data-haptic="light" title="Change your 4-digit security PIN">
        <span class="hub-btn-icon">🔑</span>
        <span class="hub-btn-text">Change PIN</span>
      </button>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <form method="POST" action="/logout" target="_top" style="margin:0;display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="singer-hub-action-btn btn-logout" data-haptic="medium" title="Logout from Admin Mode" onclick="try{localStorage.removeItem('bp_is_admin');localStorage.removeItem('bp_admin_name');localStorage.removeItem('bp_admin_role');}catch(_){}">
            <span class="hub-btn-icon">🚪</span>
            <span class="hub-btn-text">Admin Logout</span>
          </button>
        </form>
      <% } else { %>
        <form method="POST" action="/singer/logout" target="_top" style="margin:0;display:inline;">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="singer-hub-action-btn btn-logout" data-haptic="medium" title="Logout" onclick="try{localStorage.removeItem('bp_singer_id');localStorage.removeItem('bp_singer_name');localStorage.removeItem('bp_is_admin');}catch(_){}">
            <span class="hub-btn-icon">🚪</span>
            <span class="hub-btn-text">Logout</span>
          </button>
        </form>
      <% } %>
    </div>
  </div>

  <!-- Profile Hero Header -->
  <div class="singer-hub-hero">
    <div class="singer-hub-hero-inner">
      
      <!-- Avatar -->
      <div class="singer-hub-avatar-wrap">
        <div class="singer-hub-avatar">
          <%= singer.name.charAt(0).toUpperCase() %>
        </div>
        <div class="singer-hub-avatar-badge" title="Verified Devotee">🪔</div>
      </div>

      <!-- Info -->
      <div class="singer-hub-info">
        <div class="singer-hub-title-row">
          <h1 class="singer-hub-name"><%= singer.name %></h1>
          <% if (singer.gender) { %>
            <span class="singer-hub-gender-badge">
              <%= singer.gender %>
            </span>
          <% } %>
          <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <span class="singer-hub-admin-badge">
              👑 Admin Linked
            </span>
          <% } %>
        </div>

        <div class="singer-hub-meta-row">
          <span class="singer-hub-meta-item">
            <span>🛡️</span> 4-Digit PIN Protected
          </span>
          <span>•</span>
          <span class="singer-hub-meta-item" style="color: #38bdf8;">
            <span>⏳</span> <strong><%= daysRemaining %> days</strong> active on this device
          </span>
        </div>

        <div class="singer-hub-scale-card">
          <span>🎵 Singing Scale:</span>
          <strong id="displayPreferredScale" class="singer-hub-scale-val"><%= singer.preferred_scale || 'Not configured' %></strong>
          <button type="button" onclick="openPreferredScaleModal()" class="singer-hub-scale-btn" data-haptic="light">
            ✏️ Change
          </button>
        </div>
      </div>

      <!-- Quick Action CTA -->
      <div>
        <a href="/submit-form" class="singer-hub-hero-cta" data-haptic="medium">
          <span>🎤</span> Mark Bhajan Slot
        </a>
      </div>

    </div>
  </div>

  <!-- Key Metrics Row -->
  <div class="singer-metrics-grid">
    
    <div class="singer-metric-card">
      <div class="metric-card-header">
        <span class="metric-card-title">Upcoming Slots</span>
        <div class="metric-card-icon metric-icon-slots">📅</div>
      </div>
      <div class="metric-card-val metric-val-slots">
        <%= upcomingSubmissions.length %>
      </div>
      <div class="metric-card-sub">Scheduled in next session</div>
    </div>

    <div class="singer-metric-card">
      <div class="metric-card-header">
        <span class="metric-card-title">My Songbook</span>
        <div class="metric-card-icon metric-icon-songbook">📖</div>
      </div>
      <div class="metric-card-val metric-val-songbook">
        <%= songbook.length %>
      </div>
      <div class="metric-card-sub">Prepared repertoire</div>
    </div>

    <div class="singer-metric-card">
      <div class="metric-card-header">
        <span class="metric-card-title">Past Bhajans</span>
        <div class="metric-card-icon metric-icon-history">🪔</div>
      </div>
      <div class="metric-card-val metric-val-history">
        <%= pastHistory.length %>
      </div>
      <div class="metric-card-sub">In Samiti records</div>
    </div>

    <div class="singer-metric-card">
      <div class="metric-card-header">
        <span class="metric-card-title">Correction Tickets</span>
        <div class="metric-card-icon metric-icon-tickets">🎫</div>
      </div>
      <div class="metric-card-val metric-val-tickets">
        <%= myReportsCount %>
      </div>
      <a href="/my-reports" class="metric-card-sub" style="color: #0284c7; text-decoration: none; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">
        Track reports →
      </a>
    </div>

  </div>

  <!-- Interactive Hub Tabs -->
  <div class="hub-tabs-nav-bar">
    <button type="button" class="hub-tab-btn active" onclick="switchHubTab('upcoming', this)" data-haptic="light">
      <span>📅</span> Upcoming Schedule (<%= upcomingSubmissions.length %>)
    </button>
    <button type="button" class="hub-tab-btn" onclick="switchHubTab('songbook', this)" data-haptic="light">
      <span>📖</span> My Songbook & Scales (<%= songbook.length %>)
    </button>
    <button type="button" class="hub-tab-btn" onclick="switchHubTab('history', this)" data-haptic="light">
      <span>📜</span> Singing History (<%= pastHistory.length %>)
    </button>
    <button type="button" class="hub-tab-btn" onclick="switchHubTab('reports', this)" data-haptic="light">
      <span>🎫</span> My Reports (<%= myReportsCount %>)
    </button>
  </div>

  <!-- ========================================== -->
  <!-- TAB 1: UPCOMING SCHEDULE                   -->
  <!-- ========================================== -->
  <div id="tab-upcoming" class="hub-tab-pane" style="display: block;">
    <% if (upcomingSubmissions && upcomingSubmissions.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% upcomingSubmissions.forEach(function(sub) { %>
          <div style="background: var(--surface); border: 1px solid var(--border); border-left: 5px solid #ea580c; border-radius: 14px; padding: 20px; box-shadow: var(--shadow);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 10px;">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="background: #fff7ed; color: #c2410c; border: 1px solid #ffedd5; font-size: 12px; font-weight: 800; padding: 3px 9px; border-radius: 6px;">
                  📅 <%= sub.session_date %>
                </span>
                <% if (sub.list_order) { %>
                  <span style="background: #e0e7ff; color: #3730a3; font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">
                    Slot #<%= sub.list_order %>
                  </span>
                <% } %>
                <span style="background: #f1f5f9; color: #475569; font-size: 12px; font-weight: 600; padding: 3px 8px; border-radius: 6px;">
                  🕉️ <%= sub.deity %>
                </span>
              </div>
              <span style="font-size: 12px; font-weight: 700; color: <%= sub.singer_name.toLowerCase() === singer.name.toLowerCase() ? '#16a34a' : '#0284c7' %>;">
                <%= sub.singer_name.toLowerCase() === singer.name.toLowerCase() ? '🎤 Lead Singer' : '🤝 Partner Singer' %>
              </span>
            </div>

            <h3 style="font-size: 18px; font-weight: 800; color: var(--ink); margin: 0 0 10px 0;">
              <%= sub.title %>
            </h3>

            <div style="display: flex; gap: 14px; flex-wrap: wrap; font-size: 13px; color: var(--ink-soft); margin-bottom: 14px;">
              <span><strong>Tempo:</strong> <%= sub.speed || 'Medium' %></span>
              <span>•</span>
              <span><strong>Scale:</strong> <%= sub.scale || 'Standard' %></span>
              <% if (sub.partner_name) { %>
                <span>•</span>
                <span><strong>Partner:</strong> <%= sub.partner_name %></span>
              <% } %>
            </div>

            <div style="display: flex; gap: 10px; align-items: center; border-top: 1px solid var(--border); padding-top: 12px;">
              <a href="/plan-view?session_date=<%= sub.session_date %>" class="button secondary" style="padding: 6px 12px; font-size: 12.5px; text-decoration: none;">
                📊 View Full Session Plan
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: var(--surface); border: 1px dashed var(--border); border-radius: 16px; padding: 40px 20px; text-align: center;">
        <div style="font-size: 38px; margin-bottom: 10px;">📋</div>
        <h3 style="font-size: 17px; font-weight: 700; color: var(--ink); margin: 0 0 6px 0;">No Upcoming Bhajans Scheduled</h3>
        <p style="font-size: 13.5px; color: var(--ink-soft); max-width: 440px; margin: 0 auto 18px auto; line-height: 1.5;">
          You haven't submitted a bhajan for the upcoming session yet. Submissions open every Thursday after 8:00 PM.
        </p>
        <a href="/submit-form" class="button primary" style="padding: 10px 20px; font-size: 13.5px; font-weight: 700; background: #ea580c; border-color: #ea580c; text-decoration: none;">
          🎤 Submit Bhajan for Thursday
        </a>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 2: MY SONGBOOK & REPERTOIRE           -->
  <!-- ========================================== -->
  <div id="tab-songbook" class="hub-tab-pane" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
      <div>
        <h3 style="font-size: 18px; font-weight: 800; color: var(--ink); margin: 0;">📖 My Repertoire</h3>
        <p style="font-size: 13px; color: var(--ink-soft); margin: 2px 0 0 0;">
          Bhajans you have prepared, along with your personal singing pitch and notes.
        </p>
      </div>
      <a href="/master-bank" class="button secondary" style="padding: 8px 14px; font-size: 13px; text-decoration: none;">
        ➕ Browse &amp; Add Bhajans
      </a>
    </div>

    <% if (songbook && songbook.length > 0) { %>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px;">
        <% songbook.forEach(function(item) { %>
          <% const b = item.masterBhajan; %>
          <% if (!b) return; %>
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px; box-shadow: var(--shadow); display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="background: #f1f5f9; color: #475569; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 6px;">
                  🕉️ <%= b.deity %>
                </span>
                <button type="button" class="sb-remove-btn" data-id="<%= b.id %>" data-title="<%= b.title %>" title="Remove from Songbook" style="background: none; border: none; font-size: 16px; cursor: pointer; color: #94a3b8;">
                  🗑️
                </button>
              </div>

              <h4 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 8px 0; line-height: 1.4;">
                <a href="/bhajan/<%= b.id %>" style="color: inherit; text-decoration: none;">
                  <%= b.title %> ↗
                </a>
              </h4>

              <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 10px; font-size: 12.5px; margin-bottom: 10px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                  <span style="color: #64748b;">My Singing Pitch:</span>
                  <strong style="color: #8b5cf6;"><%= item.custom_scale || b.shruti || 'Not specified' %></strong>
                </div>
                <% if (item.notes) { %>
                  <div style="color: #475569; font-style: italic; font-size: 12px; margin-top: 4px; border-top: 1px dashed #cbd5e1; padding-top: 4px;">
                    "<%= item.notes %>"
                  </div>
                <% } %>
              </div>
            </div>

            <div style="display: flex; gap: 8px; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 10px; margin-top: 8px;">
              <a href="/bhajan/<%= b.id %>" class="button secondary" style="padding: 6px 12px; font-size: 12px; text-decoration: none;">
                📜 Practice Lyrics
              </a>
              <button type="button" class="button secondary sb-edit-btn" data-id="<%= b.id %>" data-title="<%= b.title %>" data-scale="<%= item.custom_scale || b.shruti || '' %>" data-notes="<%= item.notes || '' %>" style="padding: 6px 10px; font-size: 12px;">
                ✏️ Edit Pitch
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: var(--surface); border: 1px dashed var(--border); border-radius: 16px; padding: 40px 20px; text-align: center;">
        <div style="font-size: 38px; margin-bottom: 10px;">📖</div>
        <h3 style="font-size: 17px; font-weight: 700; color: var(--ink); margin: 0 0 6px 0;">Your Songbook is Empty</h3>
        <p style="font-size: 13.5px; color: var(--ink-soft); max-width: 440px; margin: 0 auto 18px auto; line-height: 1.5;">
          Build your personal repertoire! When viewing any bhajan in the Master Bank, click <strong>"⭐ Add to My Songbook"</strong> to bookmark it with your personal vocal pitch.
        </p>
        <a href="/master-bank" class="button primary" style="padding: 10px 20px; font-size: 13.5px; font-weight: 700; background: #8b5cf6; border-color: #8b5cf6; text-decoration: none;">
          🔍 Explore Master Bhajan Bank
        </a>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 3: SINGING HISTORY                     -->
  <!-- ========================================== -->
  <div id="tab-history" class="hub-tab-pane" style="display: none;">
    <div style="margin-bottom: 18px;">
      <h3 style="font-size: 18px; font-weight: 800; color: var(--ink); margin: 0 0 6px 0;">📜 My Samiti Bhajan History</h3>
      <p style="font-size: 13px; color: var(--ink-soft); margin: 0 0 14px 0;">
        Every bhajan you have sung in Gandhinagar sessions, with deity breakdown to help you maintain variety.
      </p>

      <!-- Deity Summary Badges -->
      <% const deityKeys = Object.keys(deitySummary); %>
      <% if (deityKeys.length > 0) { %>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
          <% deityKeys.forEach(function(d) { %>
            <span style="background: var(--surface); border: 1px solid var(--border); font-size: 12px; font-weight: 700; color: var(--ink); padding: 4px 10px; border-radius: 8px;">
              <%= d %>: <span style="color: #ea580c;"><%= deitySummary[d] %></span>
            </span>
          <% }); %>
        </div>
      <% } %>
    </div>

    <% if (pastHistory && pastHistory.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% pastHistory.forEach(function(item) { %>
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <span style="font-size: 12px; font-weight: 700; color: var(--ink-soft); font-family: monospace;">
                  <%= item.session_date %>
                </span>
                <span style="background: #f1f5f9; color: #475569; font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 6px;">
                  <%= item.deity %>
                </span>
                <span style="font-size: 11px; font-weight: 700; color: <%= item.singer_name.toLowerCase() === singer.name.toLowerCase() ? '#16a34a' : '#0284c7' %>;">
                  <%= item.singer_name.toLowerCase() === singer.name.toLowerCase() ? '🎤 Lead' : '🤝 Partner' %>
                </span>
              </div>
              <div style="font-size: 15px; font-weight: 700; color: var(--ink);">
                <%= item.title %>
              </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--ink-soft);">
              <span>Pitch: <strong><%= item.scale || '-' %></strong></span>
              <a href="/database?search=<%= encodeURIComponent(item.title) %>" class="button secondary" style="padding: 5px 10px; font-size: 12px; text-decoration: none;">
                Session Details
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: var(--surface); border: 1px dashed var(--border); border-radius: 16px; padding: 36px 20px; text-align: center;">
        <div style="font-size: 36px; margin-bottom: 10px;">📜</div>
        <h3 style="font-size: 16px; font-weight: 700; color: var(--ink); margin: 0 0 6px 0;">No Past Sessions Recorded</h3>
        <p style="font-size: 13.5px; color: var(--ink-soft); margin: 0;">
          Past bhajans sung under "<%= singer.name %>" will automatically show up here after each session!
        </p>
      </div>
    <% } %>
  </div>

  <!-- ========================================== -->
  <!-- TAB 4: MY REPORTS & TICKETS               -->
  <!-- ========================================== -->
  <div id="tab-reports" class="hub-tab-pane" style="display: none;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
      <div>
        <h3 style="font-size: 17px; font-weight: 800; color: var(--ink); margin: 0 0 4px 0;">Correction Tickets &amp; Feedback</h3>
        <p style="font-size: 13px; color: var(--ink-soft); margin: 0;">Track bhajan issues reported by you and responses from coordinators.</p>
      </div>
      <a href="/master-bank" class="button secondary" style="font-size: 12.5px; padding: 6px 12px; text-decoration: none;">
        🔍 Browse &amp; Report Bhajan
      </a>
    </div>

    <% if (myReports && myReports.length > 0) { %>
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <% myReports.forEach(function(r) { %>
          <%
            let statusBg = '#fef3c7'; let statusColor = '#92400e'; let statusLabel = '🟡 Pending Review';
            if (r.status === 'under_review') {
              statusBg = '#e0f2fe'; statusColor = '#0369a1'; statusLabel = '🔵 Under Review';
            } else if (r.status === 'resolved') {
              statusBg = '#dcfce7'; statusColor = '#15803d'; statusLabel = '🟢 Resolved';
            } else if (r.status === 'closed') {
              statusBg = '#f1f5f9'; statusColor = '#475569'; statusLabel = '⚪ Closed';
            }

            const catMap = {
              lyrics: '📝 Lyrics', scale: '🎵 Scale', raga: '🎼 Raga',
              deity: '🕉️ Deity', tempo: '⏱️ Tempo', sheet: '📄 Sheet',
              spelling: '✏️ Typo', other: '❓ Other'
            };
          %>
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 18px; box-shadow: var(--shadow);">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px; margin-bottom: 10px;">
              <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                  <span style="background: #1e293b; color: #f8fafc; font-family: monospace; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 6px; letter-spacing: 0.5px;">
                    <%= r.ticket_code %>
                  </span>
                  <span style="background: <%= statusBg %>; color: <%= statusColor %>; font-size: 12px; font-weight: 700; padding: 2px 10px; border-radius: 999px;">
                    <%= statusLabel %>
                  </span>
                  <span style="font-size: 12px; color: var(--ink-soft);">
                    <%= new Date(r.created_at).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                  </span>
                </div>

                <h4 style="font-size: 16px; font-weight: 800; color: var(--ink); margin: 0 0 6px 0;">
                  <% if (r.master_id) { %>
                    <a href="/bhajan/<%= r.master_id %>" style="color: inherit; text-decoration: none;">
                      <%= r.bhajan_title %> ↗
                    </a>
                  <% } else { %>
                    <%= r.bhajan_title %>
                  <% } %>
                </h4>
              </div>

              <% if (r.master_id) { %>
                <a href="/bhajan/<%= r.master_id %>" class="button secondary" style="padding: 5px 12px; font-size: 12px; text-decoration: none;">
                  View Bhajan
                </a>
              <% } %>
            </div>

            <!-- Categories tags -->
            <% if (r.categories && r.categories.length > 0) { %>
              <div style="display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px;">
                <% r.categories.forEach(function(cat) { %>
                  <span style="background: var(--bg); border: 1px solid var(--border); font-size: 11.5px; padding: 2px 8px; border-radius: 6px; color: var(--ink-soft); font-weight: 600;">
                    <%= catMap[cat] || cat %>
                  </span>
                <% }); %>
              </div>
            <% } %>

            <!-- Issue Description -->
            <div style="background: var(--bg); border-radius: 8px; padding: 10px 12px; font-size: 13px; color: var(--ink); margin-bottom: 8px; line-height: 1.45;">
              <strong>Reported Issue:</strong> <%= r.description %>
              <% if (r.suggested_correction) { %>
                <div style="margin-top: 6px; color: #16a34a; font-weight: 600;">
                  💡 <em>Suggested Correction:</em> <%= r.suggested_correction %>
                </div>
              <% } %>
            </div>

            <!-- Admin Response Callout -->
            <% if (r.admin_response) { %>
              <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 4px solid #16a34a; border-radius: 8px; padding: 10px 14px; margin-top: 10px; font-size: 13px;">
                <div style="font-weight: 800; color: #166534; display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                  <span>💬 Response from Coordinator <%= r.reviewed_by ? `(${r.reviewed_by})` : '' %></span>
                  <% if (r.reviewed_at) { %>
                    <span style="font-size: 11.5px; font-weight: normal; color: #15803d;">
                      <%= new Date(r.reviewed_at).toLocaleDateString("en-IN", { month: "short", day: "numeric" }) %>
                    </span>
                  <% } %>
                </div>
                <div style="color: #14532d; line-height: 1.45;"><%= r.admin_response %></div>
              </div>
            <% } else { %>

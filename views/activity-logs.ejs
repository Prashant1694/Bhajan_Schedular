<div class="session-unified-page">

  <!-- ═══ EXECUTIVE HEADER ═══ -->
  <header class="session-unified-header">
    <div class="session-header-top-row">
      <div class="session-header-identity">
        <div class="session-date-tile" style="background:linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(6, 182, 212, 0.15)); border-color:#10b981;">
          <span style="font-size:22px;">🕵️</span>
        </div>
        <div class="session-title-block">
          <h1>Activity Monitor &amp; User Audit</h1>
          <div class="session-tags-row">
            <span class="session-tag session-tag-regular">Real-Time Telemetry</span>
            <span class="session-tag session-tag-festival"><%= totalLogs %> Actions Tracked</span>
            <span class="session-tag session-tag-special"><%= onlineSingersCount + onlineAdminsCount %> Users Active</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="session-primary-actions" style="max-width:340px;">
        <% if (currentAdmin && (currentAdmin.role === 'super_admin' || currentAdmin.role === 'SUPER_ADMIN')) { %>
          <button type="button" onclick="purgeOldActivityLogs()" class="sec-tool-btn" style="height:42px; min-height:42px; color:#ef4444; border-color:rgba(239,68,68,0.3); flex-direction:row; gap:6px;">
            <span>🗑️</span>
            <span>Purge (&gt;30d)</span>
          </button>
        <% } %>
        <a href="/admin" class="sec-tool-btn" style="height:42px; min-height:42px; flex-direction:row; gap:6px;">
          <span>🏠</span>
          <span>Dashboard</span>
        </a>
      </div>
    </div>

    <!-- Executive Metrics Grid -->
    <div class="session-metrics-deck" style="margin-top:14px;">
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-card-icon">🛡️</div>
          <div class="metric-card-data">
            <span class="metric-card-val" id="cardOnlineAdmins"><%= onlineAdminsCount %></span>
            <span class="metric-card-lbl">Online Admins</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-card-icon">🎤</div>
          <div class="metric-card-data">
            <span class="metric-card-val" id="cardOnlineSingers"><%= onlineSingersCount %></span>
            <span class="metric-card-lbl">Online Singers</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-card-icon">👥</div>
          <div class="metric-card-data">
            <span class="metric-card-val" id="cardOnlineUsers"><%= onlineUsersCount %></span>
            <span class="metric-card-lbl">Guest Devotees</span>
          </div>
        </div>

        <div class="metric-card">
          <div class="metric-card-icon">⚡</div>
          <div class="metric-card-data">
            <span class="metric-card-val" id="cardTotalLogs"><%= totalLogs %></span>
            <span class="metric-card-lbl">Total Actions</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ USER ACCOUNTS ACTIVITY HUB ═══ -->
  <div class="activity-users-deck">
    <div class="activity-users-header">
      <div>
        <h2 class="activity-users-title">
          <span>👤</span> User Accounts Activity Hub
        </h2>
        <p class="activity-users-subtitle">
          Select any user account to filter their specific activity audit trail.
        </p>
      </div>

      <% if (filterUser) { %>
        <a href="/admin/activity-logs" class="sec-tool-btn" style="min-height:32px; height:32px; padding:0 12px; flex-direction:row; gap:6px; color:#ef4444; border-color:rgba(239,68,68,0.3); width:auto;">
          <span>✕</span>
          <span>Clear Filter: <strong><%= filterUser %></strong></span>
        </a>
      <% } %>
    </div>

    <div class="activity-user-grid">
      <% if (userSummaries && userSummaries.length > 0) { %>
        <% userSummaries.forEach(user => { 
          const isSelected = filterUser === user.username;
          let roleBadge = '👤 Guest';
          let roleChip = 'diag-chip';
          let avatarGradient = 'linear-gradient(135deg, #94a3b8, #64748b)';

          if (user.user_type === 'singer') {
            roleBadge = '🎤 Singer';
            roleChip = 'diag-chip warn';
            avatarGradient = 'linear-gradient(135deg, #ec4899, #f43f5e)';
          } else if (user.user_type === 'super_admin' || user.user_type === 'admin') {
            roleBadge = user.user_type === 'super_admin' ? '👑 Super Admin' : '🛡️ Admin';
            roleChip = 'diag-chip info';
            avatarGradient = 'linear-gradient(135deg, #9333ea, #6366f1)';
          }

          const lastActiveStr = user.last_active ? new Date(user.last_active).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Recently';
        %>
          <div 
            class="activity-user-card <%= isSelected ? 'is-active-filter' : '' %>"
            onclick="filterByUser('<%= encodeURIComponent(user.username) %>')"
            title="Click to view actions by <%= user.username %>"
          >
            <div class="activity-user-avatar" style="background:<%= avatarGradient %>;">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <div class="activity-user-info">
              <div class="activity-user-name">
                <%= user.username %>
              </div>
              <div class="activity-user-meta">
                <span class="<%= roleChip %>" style="font-size:10px; padding:1px 5px;"><%= roleBadge %></span>
                <span>• <%= user.action_count %> actions</span>
              </div>
            </div>
            <div style="font-size:10.5px; color:var(--text-light); text-align:right; flex-shrink:0;">
              <%= lastActiveStr %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p style="color:var(--text-light); font-size:13px; margin:8px 0;">No active user accounts recorded yet.</p>
      <% } %>
    </div>
  </div>

  <!-- ═══ MAIN WORKSPACE & AUDIT STREAM ═══ -->
  <main class="session-unified-workspace view-mode-table">

    <!-- Workspace Controls Bar -->
    <div class="workspace-header-bar">
      <div class="workspace-filter-box">
        <input 
          type="text" 
          id="activitySearchInput" 
          class="workspace-search-input" 
          placeholder="🔍 Search user, action, section, or song details..." 
          oninput="filterActivityRows()" 
          aria-label="Filter activity records"
        />
        
        <span class="workspace-meta-text" id="activityCountDisplay">
          Showing <%= logs.length %> Records
        </span>
      </div>

      <div class="workspace-view-controls">
        <div class="view-switcher-pill" role="group" aria-label="Event Type Filter">
          <button type="button" class="view-switch-btn <%= filterType === 'all' && !filterUser ? 'active' : '' %>" onclick="setActivityTypeFilter('all')">
            All Events
          </button>
          <button type="button" class="view-switch-btn <%= filterType === 'singer' ? 'active' : '' %>" onclick="setActivityTypeFilter('singer')">
            🎤 Singers
          </button>
          <button type="button" class="view-switch-btn <%= filterType === 'admin' ? 'active' : '' %>" onclick="setActivityTypeFilter('admin')">
            🛡️ Admins
          </button>
          <button type="button" class="view-switch-btn <%= filterType === 'guest' ? 'active' : '' %>" onclick="setActivityTypeFilter('guest')">
            👤 Guests
          </button>
        </div>
      </div>
    </div>

    <!-- Activity Stream Table -->
    <div class="workspace-table-scroll">
      <table class="sequencer-studio-table" id="activityLogsTable">
        <thead>
          <tr>
            <th width="45" style="text-align:center;">#</th>
            <th width="24%">User Account</th>
            <th width="32%">Action &amp; Details</th>
            <th width="16%">App Section</th>
            <th width="14%">Timestamp</th>
            <th width="14%" style="text-align:right;">Method &amp; IP</th>
          </tr>
        </thead>
        <tbody id="activityTableBody">
          <% if (logs.length > 0) { %>
            <% logs.forEach((log, idx) => { 
              const isSinger = log.user_type === 'singer';
              const isAdmin = log.user_type === 'super_admin' || log.user_type === 'admin';
              let roleBadge = isSinger ? '🎤 Singer' : (isAdmin ? '🛡️ Admin' : '👤 Guest');
              let roleChip = isSinger ? 'diag-chip warn' : (isAdmin ? 'diag-chip info' : 'diag-chip');
              let userInitial = log.username ? log.username.charAt(0).toUpperCase() : 'G';
              let avatarBg = isSinger ? '#ec4899' : (isAdmin ? '#7c3aed' : '#64748b');

              const dateObj = new Date(log.created_at);
              const timeStr = dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
              const dateStr = dateObj.toLocaleDateString([], { month: 'short', day: 'numeric' });
            %>
            <tr 
              class="activity-row"
              data-search="<%= ((log.username||'') + ' ' + (log.action||'') + ' ' + (log.details||'') + ' ' + (log.section||'')).toLowerCase() %>"
            >
              <!-- Index -->
              <td style="text-align:center; color:var(--text-light); font-weight:700;">
                <%= idx + 1 %>
              </td>

              <!-- User -->
              <td>
                <div class="admin-user-cell">
                  <div class="admin-avatar-pill" style="background:<%= avatarBg %>;">
                    <%= userInitial %>
                  </div>
                  <div>
                    <div class="admin-name-title"><%= log.username %></div>
                    <div class="admin-meta-sub">
                      <span class="<%= roleChip %>" style="font-size:10px; padding:1px 5px;"><%= roleBadge %></span>
                    </div>
                  </div>
                </div>
              </td>

              <!-- Action & Details -->
              <td>
                <div style="font-weight:700; font-size:13px; color:var(--text);">
                  <%= log.details || log.action %>
                </div>
                <div style="font-size:11px; color:var(--text-light); margin-top:2px; font-family:monospace;">
                  Action: <%= log.action %>
                </div>
              </td>

              <!-- Section -->
              <td>
                <span class="session-tag session-tag-regular" style="font-size:11px;">
                  <%= log.section %>
                </span>
              </td>

              <!-- Timestamp -->
              <td>
                <div style="font-weight:700; font-size:12.5px; color:var(--text);"><%= timeStr %></div>
                <div style="font-size:11px; color:var(--text-light);"><%= dateStr %></div>
              </td>

              <!-- Method & IP -->
              <td style="text-align:right;">
                <span class="diag-chip <%= log.method === 'POST' ? 'warn' : 'info' %>" style="font-size:10.5px; padding:1px 6px;">
                  <%= log.method %>
                </span>
                <div style="font-size:11px; color:var(--text-light); margin-top:3px; max-width:180px; margin-left:auto; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                  <%= log.ip_address || 'Local' %>
                </div>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" style="text-align:center; padding:36px; color:var(--text-light);">
                No activity records found.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="activityEmptyState" class="sequencer-empty-state" style="display:none;">
      <div style="font-size:36px; margin-bottom:8px;">🔍</div>
      <h3 style="margin:0 0 4px 0; font-size:16px; font-weight:700; color:var(--text);">No activities found</h3>
      <p style="margin:0; font-size:13px; color:var(--text-light);">No actions match your search query.</p>
    </div>
  </main>

</div>

<script>
function filterByUser(encodedUsername) {
  const user = decodeURIComponent(encodedUsername);
  window.location.href = `/admin/activity-logs?user=${encodeURIComponent(user)}`;
}

function setActivityTypeFilter(type) {
  window.location.href = `/admin/activity-logs?user_type=${type}`;
}

function filterActivityRows() {
  const query = (document.getElementById('activitySearchInput')?.value || '').trim().toLowerCase();
  const rows = document.querySelectorAll('#activityTableBody tr.activity-row');
  let visibleCount = 0;

  rows.forEach(row => {
    const haystack = row.getAttribute('data-search') || '';
    if (!query || haystack.includes(query)) {
      row.style.display = '';
      visibleCount++;
    } else {
      row.style.display = 'none';
    }
  });

  const emptyState = document.getElementById('activityEmptyState');
  if (emptyState) {
    emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
  }

  const countDisplay = document.getElementById('activityCountDisplay');
  if (countDisplay) {
    countDisplay.textContent = `Showing ${visibleCount} Record${visibleCount === 1 ? '' : 's'}`;
  }
}

async function purgeOldActivityLogs() {
  if (!confirm("Are you sure you want to purge activity logs older than 30 days?")) return;
  try {
    const res = await fetch("/admin/activity-logs/purge", { method: "POST" });
    const data = await res.json();
    if (data.success) {
      alert(data.message);
      window.location.reload();
    } else {
      alert("Error: " + (data.error || "Purge failed"));
    }
  } catch (err) {
    alert("Purge failed: " + err.message);
  }
}
</script>

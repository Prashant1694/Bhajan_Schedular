<div class="container container-xl">
  <div class="header">
    <h1>🗃️ Bhajan History</h1>
    <p>Session Records - Gandhinagar Bhajan Schedules</p>
  </div>
  <div style="margin-bottom: 20px;">
    <a href="<%= currentAdmin ? '/admin' : '/' %>" class="button secondary">
      <%= currentAdmin ? '🏠 Dashboard' : '🏠 Home' %>
    </a>
  </div>

  <% if (sessions.length === 0) { %>
    <div class="submitted-bhajans" style="text-align: center; padding: 40px 20px;">
      <p style="font-size: 16px; color: var(--muted);">No session records found yet.</p>
    </div>
  <% } else { %>
    <%# Date filter bar %>
    <div class="history-filter-bar">
      <label for="historyDateFilter">Filter by date</label>
      <div class="history-filter-controls">
        <input type="date" id="historyDateFilter" class="filter-input" />
        <button type="button" id="historyDateClear" class="button secondary" style="padding: 8px 14px; font-size: 13px;">Clear</button>
      </div>
    </div>

    <div id="historyNoMatch" class="submitted-bhajans" style="text-align: center; padding: 30px 20px; display: none;">
      <p style="font-size: 15px; color: var(--muted);">No session found for the selected date.</p>
    </div>

    <% const initialSessions = sessions.slice(0, 12); %>
    <% initialSessions.forEach((session, sIdx) => { %>
      <section class="submitted-bhajans history-session" data-date="<%= session.date %>">
        <div class="submitted-bhajans-heading">
          <div>
            <h3>📅 <%= session.heading %></h3>
            <p><%= session.bhajans.length %> bhajan<%= session.bhajans.length === 1 ? '' : 's' %> in this session</p>
          </div>
        </div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Singer</th>
                <th>Deity</th>
                <th>Bhajan</th>
                <th>Speed</th>
                <th>Scale</th>
              </tr>
            </thead>
            <tbody>
              <% session.bhajans.forEach((s, i) => { %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><strong><%= s.singer_name %></strong></td>
                  <td><span class="deity-pill"><%= s.deity %></span></td>
                  <td><%= s.title %></td>
                  <td><%= s.speed || '-' %></td>
                  <td><%= s.scale || '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% }) %>

    <div id="historyDynamicContainer"></div>

    <% if (sessions.length > 12) { %>
      <div id="historyLoadMoreContainer" style="text-align: center; margin: 28px 0 40px;">
        <button type="button" id="historyLoadMoreBtn" class="button secondary" style="padding: 12px 28px; font-size: 15px; font-weight: 600; border-radius: 10px;">
          📜 Load More Past Sessions (<span id="historyRemainingCount"><%= sessions.length - 12 %></span> remaining)
        </button>
      </div>
    <% } %>
  <% } %>
</div>

<script id="remainingSessionsData" type="application/json">
  <%- JSON.stringify(sessions.slice(12)) %>
</script>

<script>
(function() {
  var dateInput = document.getElementById('historyDateFilter');
  var clearBtn = document.getElementById('historyDateClear');
  var noMatch  = document.getElementById('historyNoMatch');
  var loadMoreBtn = document.getElementById('historyLoadMoreBtn');
  var loadMoreContainer = document.getElementById('historyLoadMoreContainer');
  var remainingCount = document.getElementById('historyRemainingCount');
  var dynamicContainer = document.getElementById('historyDynamicContainer');

  var remainingSessions = [];
  try {
    var rawData = document.getElementById('remainingSessionsData');
    if (rawData) remainingSessions = JSON.parse(rawData.textContent);
  } catch (e) {}

  var currentIndex = 0;
  var BATCH_SIZE = 12;

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderSessionHtml(session) {
    var rows = session.bhajans.map(function(s, i) {
      return '<tr>' +
        '<td>' + (i + 1) + '</td>' +
        '<td><strong>' + escapeHtml(s.singer_name) + '</strong></td>' +
        '<td><span class="deity-pill">' + escapeHtml(s.deity) + '</span></td>' +
        '<td>' + escapeHtml(s.title) + '</td>' +
        '<td>' + escapeHtml(s.speed || '-') + '</td>' +
        '<td>' + escapeHtml(s.scale || '-') + '</td>' +
        '</tr>';
    }).join('');

    return '<section class="submitted-bhajans history-session" data-date="' + escapeHtml(session.date) + '">' +
      '<div class="submitted-bhajans-heading">' +
        '<div>' +
          '<h3>📅 ' + escapeHtml(session.heading) + '</h3>' +
          '<p>' + session.bhajans.length + ' bhajan' + (session.bhajans.length === 1 ? '' : 's') + ' in this session</p>' +
        '</div>' +
      '</div>' +
      '<div class="table-container">' +
        '<table>' +
          '<thead>' +
            '<tr><th>#</th><th>Singer</th><th>Deity</th><th>Bhajan</th><th>Speed</th><th>Scale</th></tr>' +
          '</thead>' +
          '<tbody>' + rows + '</tbody>' +
        '</table>' +
      '</div>' +
    '</section>';
  }

  function loadNextBatch() {
    if (currentIndex >= remainingSessions.length) return;
    var nextBatch = remainingSessions.slice(currentIndex, currentIndex + BATCH_SIZE);
    var html = nextBatch.map(renderSessionHtml).join('');
    if (dynamicContainer) dynamicContainer.insertAdjacentHTML('beforeend', html);
    currentIndex += nextBatch.length;

    var left = remainingSessions.length - currentIndex;
    if (left > 0) {
      if (remainingCount) remainingCount.textContent = left;
    } else {
      if (loadMoreContainer) loadMoreContainer.style.display = 'none';
    }
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', loadNextBatch);
  }

  function filterSessions() {
    var val = (dateInput ? dateInput.value : '').trim(); // YYYY-MM-DD or empty
    var rendered = document.querySelectorAll('.history-session');

    if (!val) {
      if (noMatch) noMatch.style.display = 'none';
      rendered.forEach(function(sec) { sec.style.display = ''; });
      var left = remainingSessions.length - currentIndex;
      if (loadMoreContainer) loadMoreContainer.style.display = left > 0 ? '' : 'none';
      return;
    }

    if (loadMoreContainer) loadMoreContainer.style.display = 'none';

    // Check if the session is already rendered
    var found = false;
    rendered.forEach(function(sec) {
      if (sec.getAttribute('data-date') === val) {
        sec.style.display = '';
        found = true;
      } else {
        sec.style.display = 'none';
      }
    });

    // If not found in currently rendered DOM, search unrendered remainingSessions
    if (!found) {
      var targetSession = remainingSessions.find(function(s) { return s.date === val; });
      if (targetSession && dynamicContainer) {
        var html = renderSessionHtml(targetSession);
        dynamicContainer.insertAdjacentHTML('beforeend', html);
        found = true;
      }
    }

    if (noMatch) noMatch.style.display = !found ? '' : 'none';
  }

  if (dateInput) {
    dateInput.addEventListener('change', filterSessions);
  }
  if (clearBtn) {
    clearBtn.addEventListener('click', function() {
      if (dateInput) dateInput.value = '';
      filterSessions();
    });
  }
})();
</script>
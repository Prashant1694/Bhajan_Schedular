<div class="container container-lg">
    <div class="header">
      <h1>📈 Analytics</h1>
      <p>Most Popular Bhajans</p>
    </div>
    
    <div style="margin-bottom: 20px;">
      <a href="/admin" class="button secondary">⬅️ Back to Admin</a>
    </div>

    <div class="card analytics-card">
      <h3 style="margin-bottom:16px; display:flex; align-items:center; gap:8px;">
        <span>🏆 Top 15 Most Sung Bhajans</span>
      </h3>
      
      <div class="table-container">
        <table class="analytics-table">
          <thead>
            <tr>
              <th style="width:90px;">Rank</th>
              <th>Bhajan Title</th>
              <th style="text-align:center; width:130px;">Times Sung</th>
            </tr>
          </thead>
          <tbody>
            <% topBhajans.forEach((b, i) => { %>
              <tr>
                <td><span class="rank-pill <%= i < 3 ? 'rank-top' : '' %>">#<%= i + 1 %></span></td>
                <td><strong><%= b.title %></strong></td>
                <td style="text-align:center;"><span class="badge-count"><%= b.count %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
